<view class="home-page">
  <view class="scroll-container">
    <scroll-view class="home-scroll" scroll-y="true" enhanced="true" bounces="true" show-scrollbar="false">
      <view class="page-body">
        <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>
        <view class="page-header">
          <view class="header-copy">
            <text class="hello-line">Hello</text>
            <text class="destiny-line">{{destinyLine}}</text>
          </view>
        </view>

        <view class="inspiration-card {{cardClass}}" bindtap="toggleInspiration">
          <view class="inspiration-front">
            <view class="inspiration-grid"></view>
            <view class="inspiration-head">
              <view class="inspiration-label">
                <view class="inspiration-dot"></view>
                <text>Today's Inspiration</text>
              </view>
              <text class="inspiration-no">{{inspiration.no}}</text>
            </view>
            <view class="inspiration-center">
              <view class="inspiration-ring">
                <view class="inspiration-ring-inner"></view>
                <text class="inspiration-symbol">{{inspiration.symbol}}</text>
              </view>
              <text class="inspiration-title">{{inspiration.title}}</text>
              <text class="inspiration-subtitle">{{inspiration.subtitle}}</text>
            </view>
            <view class="inspiration-copy">
              <text class="inspiration-quote">“</text>
              <text class="inspiration-text">{{inspiration.text}}</text>
            </view>
          </view>
          <view class="inspiration-back">
            <view class="inspiration-back-grid"></view>
            <view class="inspiration-back-core"></view>
            <text class="inspiration-back-title">DAILY INSPIRATION</text>
            <text class="inspiration-back-tip">Tap to flip</text>
          </view>
        </view>

        <view class="stats-row">
          <view class="stat-card stat-left mood-card" style="{{moodCardStyle}}">
            <view class="mood-card__header">
              <view class="mood-card__caption" style="{{moodAccentStyle}}">
                <view class="mood-card__dot" style="{{moodDotStyle}}"></view>
                <text class="mood-card__title">Today's Mood</text>
              </view>
              <text class="mood-card__tag" style="{{moodTagStyle}}">{{mood.tag}}</text>
            </view>
            <text class="mood-card__hint">Your daily mood is ready</text>
            <text class="mood-card__name">{{mood.name}}</text>
            <text class="mood-card__desc">{{mood.description}}</text>
          </view>
          <view class="stat-card stat-right color-card" style="{{moodColorCardStyle}}">
            <view class="color-card__header">
              <view class="mood-card__caption" style="{{moodAccentStyle}}">
                <view class="mood-card__dot" style="{{moodDotStyle}}"></view>
                <text class="mood-card__title">Today's Color</text>
              </view>
            </view>
            <view class="color-card__value-row">
              <text class="color-card__value">{{moodColorTitle}}</text>
              <view class="color-card__swatch" style="background-color: {{mood.theme_color}}; {{colorSwatchStyle}}"></view>
            </view>
            <text class="color-card__desc">{{moodColorDesc}}</text>
          </view>
        </view>

        <view class="device-card" bindtap="openDevice">
          <view class="device-icon-wrap">
            <image class="device-icon-image" src="/pages/home/assets/device-bluetooth.png" mode="aspectFill"></image>
          </view>
          <view class="device-main">
            <text class="device-title">{{device.title}}</text>
            <text class="device-name">{{device.name}}</text>
          </view>
          <view class="device-side">
            <view class="device-status-row">
              <view class="device-status-dot {{device.statusClass}}"></view>
              <text class="device-status {{device.statusClass}}">{{device.status}}</text>
            </view>
            <view class="device-battery-row">
              <view class="battery-icon">
                <view class="battery-cap"></view>
                <view class="battery-level" style="width: {{device.batteryWidth || '0%'}};"></view>
              </view>
              <text class="device-battery">{{device.battery}}</text>
            </view>
          </view>
        </view>

        <view class="section-head">
          <text class="section-title">Style Reference</text>
          <button class="section-link" bindtap="openProducts">More Ideas ›</button>
        </view>

        <view class="gallery">
          <view class="gallery-col gallery-col-left">
            <block wx:for="{{leftProducts}}" wx:key="image">
              <view class="product-card {{item.cardClass}}">
                <image class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load="true"></image>
                <text wx:if="{{item.tag}}" class="product-tag">{{item.tag}}</text>
              </view>
            </block>
          </view>
          <view class="gallery-col gallery-col-right">
            <block wx:for="{{rightProducts}}" wx:key="image">
              <view class="product-card {{item.cardClass}}">
                <image class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load="true"></image>
                <text wx:if="{{item.tag}}" class="product-tag">{{item.tag}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-nav">
    <button class="nav-item active" bindtap="noop">
      <view class="nav-top"></view>
      <text class="nav-label">Home</text>
    </button>
    <button class="nav-item" bindtap="goData">
      <view class="nav-top"></view>
      <text class="nav-label">Records</text>
    </button>
    <button class="nav-item" bindtap="goSettings">
      <view class="nav-top"></view>
      <text class="nav-label">Settings</text>
    </button>
  </view>
</view>
