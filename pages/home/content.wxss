.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  min-height: 154rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background-color: #171920;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.stat-left { float: none; }
.stat-right { float: none; }
.gallery-col-left { float: none; }
.gallery-col-right { float: none; }

.stat-caption {
  display: block;
  font-size: 18rpx;
  color: #8db8ff;
}

.stat-pink {
  color: #ff7aa8;
}

.stat-value {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 500;
  color: #ffffff;
}

.stat-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.48);
}

.device-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.2);
  background:
    linear-gradient(180deg, rgba(8, 15, 12, 0.96), rgba(10, 19, 15, 0.92)),
    radial-gradient(circle at left, rgba(36, 166, 108, 0.12), transparent 35%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.02);
  box-sizing: border-box;
}

.device-icon-wrap {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background-color: rgba(57, 216, 122, 0.1);
}

.device-icon-image {
  width: 68rpx;
  height: 68rpx;
}

.device-main {
  flex: 1;
  min-width: 0;
}

.device-title {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(220, 252, 231, 0.62);
}

.device-name {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.22;
  font-weight: 500;
  color: #ffffff;
  word-break: break-all;
}

.device-side {
  flex: none;
  min-width: 120rpx;
  padding-top: 2rpx;
}

.device-status-row,
.device-battery-row {
  overflow: hidden;
}

.device-battery-row {
  margin-top: 16rpx;
}

.device-status-dot {
  float: left;
  width: 12rpx;
  height: 12rpx;
  margin-top: 9rpx;
  border-radius: 6rpx;
  background-color: rgba(255, 255, 255, 0.32);
}

.device-status {
  float: left;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.52);
}

.device-status-dot.device-connected {
  background-color: #39d87a;
  box-shadow: 0 0 12rpx rgba(57, 216, 122, 0.6);
}

.device-status.device-connected {
  color: #39d87a;
}

.battery-icon {
  position: relative;
  float: left;
  width: 34rpx;
  height: 18rpx;
  margin-top: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 4rpx;
}

.battery-cap {
  position: absolute;
  right: -6rpx;
  top: 4rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 0 2rpx 2rpx 0;
  background-color: rgba(255, 255, 255, 0.72);
}

.battery-level {
  position: absolute;
  left: 3rpx;
  top: 3rpx;
  width: 22rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background-color: #8df2a8;
}

.device-battery {
  float: left;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 500;
  color: #ffffff;
}

.section-link {
  flex: none;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background-color: rgba(0, 185, 120, 0.16);
  font-size: 22rpx;
  font-weight: 500;
  color: #39d87a;
}

.gallery {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.gallery-col {
  flex: 1;
  min-width: 0;
}

.product-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  margin-bottom: 22rpx;
  border-radius: 24rpx;
  background-color: #1a1d24;
}

.product-card-tall {
  height: 360rpx;
}

.product-card-short {
  height: 248rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background-color: #39d87a;
  color: #052611;
  font-size: 18rpx;
  font-weight: 500;
}

.custom-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.24);
  background-color: rgba(0, 95, 68, 0.72);
}

.custom-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: rgba(57, 216, 122, 0.14);
  color: #39d87a;
  text-align: center;
  line-height: 76rpx;
  font-size: 18rpx;
}

.custom-copy {
  flex: 1;
  min-width: 0;
}

.custom-title {
  display: block;
  font-size: 32rpx;
  color: #ffffff;
}

.custom-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.44);
}

.custom-arrow {
  flex: none;
  font-size: 40rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.54);
}
