@import "./inspiration.wxss";
@import "./mood.wxss";
@import "./content.wxss";
@import "./nav.wxss";

.home-page {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  background: #050806;
  background-color: #050806;
  color: #ffffff;
  overflow: hidden;
}

.scroll-container {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #050806;
  overflow: hidden;
}

.home-scroll {
  height: 100vh;
  min-height: 100%;
  background-color: #050806;
}

.page-body {
  min-height: 100%;
  padding: 18rpx 28rpx calc(150rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  background-color: #050806;
  box-sizing: border-box;
}

.page-top-spacer {
  width: 100%;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.hello-line {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
}

.destiny-line {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.46);
}

.bottom-space {
  height: 28rpx;
}

.inspiration-card {
  height: auto;
  min-height: 532rpx;
  margin-bottom: 22rpx;
  border-color: rgba(16, 185, 129, 0.18);
}

.inspiration-front {
  height: auto;
  min-height: 532rpx;
  padding: 24rpx 30rpx 28rpx;
}

.inspiration-back {
  position: absolute;
  inset: 0;
  height: 100%;
  min-height: 532rpx;
}

.inspiration-card-flipped .inspiration-front {
  display: block;
  visibility: hidden;
}

.inspiration-head {
  margin-bottom: 30rpx;
}

.inspiration-label,
.inspiration-no {
  font-size: 24rpx;
}

.inspiration-center {
  margin-bottom: 24rpx;
}

.inspiration-ring {
  width: 136rpx;
  height: 136rpx;
  margin-bottom: 18rpx;
  border-radius: 68rpx;
}

.inspiration-ring-inner {
  inset: 17rpx;
  border-radius: 51rpx;
  border-width: 3rpx;
}

.inspiration-symbol {
  line-height: 136rpx;
  font-size: 62rpx;
}

.inspiration-title {
  font-size: 44rpx;
}

.inspiration-subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.58);
}

.inspiration-copy {
  min-height: 112rpx;
  padding: 22rpx 24rpx 22rpx 56rpx;
  border-radius: 22rpx;
}

.inspiration-quote {
  left: 30rpx;
  top: 23rpx;
}

.inspiration-text {
  font-size: 27rpx;
  line-height: 1.62;
  color: rgba(232, 250, 240, 0.95);
}

.stats-row {
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.mood-card,
.color-card {
  min-height: 190rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.02);
  box-sizing: border-box;
}

.mood-card__header,
.color-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.mood-card__caption {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 17rpx;
  line-height: 1.3;
  opacity: 0.82;
}

.mood-card__dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.mood-card__tag {
  flex: none;
  max-width: 82rpx;
  padding: 2rpx 9rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.16);
  border-radius: 999rpx;
  font-size: 16rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  opacity: 0.78;
}

.mood-card__hint {
  display: block;
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.5);
}

.mood-card__name {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.28;
  font-weight: 500;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mood-card__desc {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.62);
  font-size: 19rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.color-card__swatch {
  width: 40rpx;
  height: 40rpx;
  margin-top: 18rpx;
  border-radius: 50%;
}

.color-card__value {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 500;
  word-break: break-all;
}

.color-card__desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 19rpx;
  line-height: 1.45;
}

.section-link {
  background-color: rgba(0, 185, 120, 0.1);
  color: rgba(120, 235, 188, 0.82);
}

.nav-item {
  color: rgba(236, 240, 237, 0.5);
}

.nav-item.active {
  color: #00d494;
}
