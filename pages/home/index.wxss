.entry-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #050806;
  color: #ffffff;
}

.entry-glow {
  position: absolute;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.22;
}

.entry-glow-top {
  top: -240rpx;
  right: -180rpx;
  background: #37d879;
}

.entry-glow-bottom {
  bottom: -280rpx;
  left: -180rpx;
  background: #b6955c;
}

.entry-content {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 100vh;
  padding: 0 64rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.brand-mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  align-items: center;
  justify-content: center;
}

.brand-mark view {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #39d87a;
  border-radius: 50%;
}

.brand-name {
  margin-top: 30rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.entry-status {
  margin-top: 72rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 24rpx;
}

.retry-button {
  width: 300rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  background: #0d8f68;
  color: #ffffff;
  font-size: 28rpx;
}

.retry-button::after {
  border: 0;
}
