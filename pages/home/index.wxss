@import "./inspiration.wxss";
@import "./mood.wxss";
@import "./content.wxss";
@import "./nav.wxss";

.home-page {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  background-color: #050806;
  color: #ffffff;
  overflow: hidden;
}

.scroll-container {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.home-scroll {
  height: 100%;
  background-color: #050806;
}

.page-body {
  min-height: 100%;
  padding: 38rpx 40rpx 240rpx;
}

.page-top-spacer {
  width: 100%;
}

.page-header {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.header-copy {
  float: left;
  padding-top: 12rpx;
}

.hello-line {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
}

.destiny-line {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.46);
}

.capsule-action {
  float: right;
  height: 58rpx;
  padding: 0 18rpx;
  margin-top: 10rpx;
  border-radius: 29rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  line-height: 58rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
}

.capsule-divider {
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.3);
}


.bottom-space {
  height: 70rpx;
}
