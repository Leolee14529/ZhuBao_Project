.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  height: 112rpx;
  height: 146rpx;
  height: calc(112rpx + constant(safe-area-inset-bottom));
  height: calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 8rpx 18rpx 0;
  padding: 8rpx 18rpx 34rpx;
  padding: 8rpx 18rpx constant(safe-area-inset-bottom);
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  border-radius: 26rpx 26rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 0;
  background: #070708;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.34), 0 0 38rpx rgba(0, 212, 148, 0.08);
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  overflow: hidden;
}

.bottom-nav::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 4rpx;
  background-color: #070708;
  pointer-events: none;
}

.nav-item {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: transparent;
  border: 0;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1;
}

.nav-item::after {
  border: 0;
}

.nav-top {
  position: absolute;
  top: -8rpx;
  width: 54rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: transparent;
}

.nav-label {
  font-weight: 500;
  font-size: 30rpx;
  line-height: 1.2;
}

.nav-item.active {
  color: #00d494;
}

.nav-item.active .nav-top {
  background: #00d494;
  box-shadow: 0 0 16rpx rgba(0, 212, 148, 0.58);
}

