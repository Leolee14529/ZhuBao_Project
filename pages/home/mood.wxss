.mood-stat {
  min-height: 236rpx;
}

.mood-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.mood-option {
  flex: 1 0 86rpx;
  max-width: 100rpx;
  height: 46rpx;
  padding: 0;
  border-radius: 23rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  line-height: 44rpx;
  text-align: center;
}

.mood-option::after {
  border: 0;
}

.mood-option-selected {
  border-color: rgba(232, 217, 181, 0.72);
  background: rgba(232, 217, 181, 0.16);
  color: #e8d9b5;
}
