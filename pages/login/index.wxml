<view class="login-page">
  <view class="login-backdrop">
    <image class="login-bg" src="/assets/auth/bg-login.jpg" mode="aspectFill" fade-in="{{false}}"></image>
    <view class="login-shade"></view>
  </view>
  <status-bar></status-bar>
  <view class="login-content">
    <view class="brand-block">
      <view class="brand-mark"><view></view></view>
      <text class="brand-name">Ting's</text>
      <text class="brand-subtitle">Computing Power Jewelry</text>
    </view>
    <view class="login-form">
      <view wx:if="{{accountAuthEnabled}}" class="mode-tabs">
        <view class="mode-tab {{loginMode === 'wechat' ? 'mode-tab-on' : ''}}" data-mode="wechat" bindtap="switchLoginMode">WeChat</view>
        <view class="mode-tab {{loginMode === 'account' ? 'mode-tab-on' : ''}}" data-mode="account" bindtap="switchLoginMode">Account</view>
      </view>
      <empty-state
        wx:if="{{serviceError}}"
        title="Login unavailable"
        desc="{{serviceError}}"
        buttonText="Retry"
        type="auth"
        compact="{{true}}"
        bind:action="retryLogin"
      ></empty-state>
      <block wx:if="{{accountAuthEnabled && loginMode === 'account'}}">
        <view class="field">
          <input value="{{accountName}}" bindinput="onAccountInput" placeholder="Account / Email" placeholder-class="placeholder" confirm-type="next"></input>
        </view>
        <view class="field">
          <input value="{{password}}" bindinput="onPasswordInput" password="{{true}}" placeholder="Password" placeholder-class="placeholder" confirm-type="done"></input>
        </view>
        <button class="primary" bindtap="accountLogin" loading="{{isAccountSubmitting}}" disabled="{{isLoggingIn || isAccountSubmitting || isCreatingAccount}}" hover-class="primary-hover"><text>Log In</text></button>
        <button class="secondary" bindtap="accountRegister" loading="{{isCreatingAccount}}" disabled="{{isLoggingIn || isAccountSubmitting || isCreatingAccount}}" hover-class="secondary-hover"><text>Create Account</text></button>
      </block>
      <block wx:else>
        <button class="primary" bindtap="login" loading="{{isLoggingIn}}" disabled="{{isLoggingIn || isAccountSubmitting || isCreatingAccount}}" hover-class="primary-hover"><text>WeChat Login</text></button>
      </block>
      <view class="agreement-row" bindtap="toggleAgreement">
        <view class="agreement-check {{agreed ? 'agreement-check-on' : ''}}">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <view class="agreement-copy">
          <text>I have read and agree to</text>
          <text class="agreement-link" catchtap="openAgreement">the User Agreement</text>
          <text>and</text>
          <text class="agreement-link" catchtap="openPrivacy">the Privacy Policy</text>
        </view>
      </view>
      <view class="link-row">
        <text bindtap="openWechatPrivacy">WeChat Privacy Guide</text>
        <text bindtap="enterGuest">Browse Home as Guest</text>
      </view>
    </view>
  </view>
  <view class="home-indicator"></view>
</view>
