<view class="login-page">
  <view class="login-backdrop">
    <image class="login-bg" src="/subpackage/jewelry/assets/bg-login.webp" mode="aspectFill"></image>
    <view class="login-shade"></view>
  </view>
  <status-bar></status-bar>
  <view class="login-content">
    <view class="brand-block">
      <view class="brand-mark"><view></view></view>
      <text class="brand-name">Ting's</text>
      <text class="brand-subtitle">Computing Power Jewelry</text>
    </view>
    <view class="login-form">
      <empty-state
        wx:if="{{serviceError}}"
        title="登录暂时不可用"
        desc="{{serviceError}}"
        buttonText="重试"
        type="auth"
        compact="{{true}}"
        bind:action="retryLogin"
      ></empty-state>
      <view class="field"><text class="field-icon">ID</text><input placeholder="邮箱 / 手机号" placeholder-class="placeholder" /></view>
      <view class="field"><input password="{{passwordMode}}" placeholder="密码" placeholder-class="placeholder" /><view class="eye" bindtap="togglePassword">{{eyeText}}</view></view>
      <button class="primary" bindtap="login" hover-class="primary-hover"><text>登录</text></button>
      <view class="link-row"><text bindtap="openRegister">注册账号</text><text>忘记密码?</text></view>
    </view>
  </view>
  <view class="home-indicator"></view>
</view>
