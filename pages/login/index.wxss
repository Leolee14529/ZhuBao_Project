.login-page{position:relative;height:100vh;display:flex;flex-direction:column;overflow:hidden;background:#000;color:#fff}.login-backdrop{position:fixed;inset:0;z-index:0;overflow:hidden}.login-bg{position:absolute;inset:0;width:100%;height:100%;filter:brightness(.68) saturate(.62);transform:scale(1.03)}.login-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1) 0%,rgba(0,0,0,.54) 42%,rgba(0,0,0,.9) 66%,#050505 100%)}.login-content{position:relative;z-index:5;height:100vh;padding:52rpx 32rpx 0;display:flex;flex-direction:column;box-sizing:border-box}.brand-block{padding:46rpx 16rpx 0}.brand-mark{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;margin-bottom:16rpx;border:2rpx solid #16a77a;border-radius:50%;box-sizing:border-box}.brand-mark-inner{width:38rpx;height:38rpx;border:4rpx solid #16a77a;border-radius:50%;box-sizing:border-box}.brand-name{display:block;color:#fff;font-size:56rpx;font-weight:400;line-height:1.15}.brand-description{display:block;margin-top:10rpx;color:rgba(255,255,255,.68);font-size:24rpx;line-height:1.5}
.login-form{position:relative;z-index:6;margin:auto -32rpx 0;padding:24rpx 56rpx calc(28rpx + constant(safe-area-inset-bottom));padding:24rpx 56rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:48rpx 48rpx 0 0;background:rgba(10,10,10,.9);box-sizing:border-box}.mode-tabs{position:relative;display:flex;height:88rpx;margin:0 0 20rpx;padding:4rpx;border-radius:20rpx;background:rgba(255,255,255,.06);box-sizing:border-box}.mode-tab{position:relative;z-index:1;flex:1;display:flex;align-items:center;justify-content:center;height:80rpx;border-radius:16rpx;color:rgba(255,255,255,.48);font-size:26rpx;font-weight:500;transition:color 240ms linear,background 240ms linear}.mode-tab-on{color:#fff;font-weight:600;background:rgba(255,255,255,.08)}.mode-tabs-indicator{position:absolute;z-index:0;bottom:8rpx;left:calc(25% - 20rpx);width:40rpx;height:4rpx;border-radius:999rpx;background:#16a77a;transition:left 240ms linear}.mode-tabs-indicator-account{left:calc(75% - 20rpx)}
.auth-panel-stage{position:relative;height:88rpx;overflow:hidden;transition:height 240ms linear}.auth-panel-stage-account{height:458rpx}.auth-panel-stage-error{height:310rpx}.auth-panel-stage-account.auth-panel-stage-error{height:458rpx}.auth-panel{position:absolute;top:0;left:0;width:100%;box-sizing:border-box;transition:opacity 240ms linear,transform 240ms linear}.auth-panel-active{z-index:2;opacity:1;transform:translateY(0)}.auth-panel-inactive{opacity:0;transform:translateY(12rpx)}.auth-panel-wechat{min-height:88rpx}.login-error{display:block;margin-bottom:16rpx}.field{position:relative;height:84rpx;margin-bottom:16rpx;display:flex;align-items:center;border:1rpx solid rgba(255,255,255,.12);border-radius:20rpx;background:rgba(255,255,255,.05)}.login-input{flex:1;min-width:0;height:100%;padding:0 28rpx;color:#fff;font-size:27rpx}.placeholder{color:rgba(255,255,255,.38)}.primary{width:100%;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:26rpx;color:#fff;font-size:28rpx;font-weight:600;letter-spacing:1rpx;background:#16a77a}.auth-panel-wechat .primary{margin-top:0}.primary-hover{opacity:.88}.secondary{width:100%;height:74rpx;margin-top:14rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;color:rgba(255,255,255,.78);font-size:25rpx;font-weight:500;background:rgba(255,255,255,.08)}.secondary-hover{opacity:.86}.account-notice{display:block;margin:14rpx 12rpx 0;color:rgba(255,255,255,.52);font-size:21rpx;line-height:1.5;text-align:center}
.agreement-row{width:100%;min-height:56rpx;display:flex;align-items:flex-start;gap:14rpx;margin-top:20rpx;padding:6rpx 0;background:transparent;color:rgba(255,255,255,.72);text-align:left}.agreement-row::after{border:0}.agreement-row-hover{opacity:.8}.agreement-check{flex:0 0 auto;width:30rpx;height:30rpx;margin-top:2rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:8rpx;color:#fff;font-size:20rpx;line-height:30rpx;text-align:center}.agreement-check-on{border-color:#16a77a;background:#16a77a}.agreement-copy{flex:1;min-width:0;font-size:22rpx;line-height:1.5}.agreement-link{color:#16a77a;font-weight:600}.link-row{display:flex;align-items:center;justify-content:center;margin-top:18rpx;font-size:22rpx;line-height:1.5}.guest-link{color:rgba(255,255,255,.64)}
