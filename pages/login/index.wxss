.login-page{position:relative;min-height:100vh;height:auto;overflow-x:hidden;overflow-y:auto;background:#000;color:#fff}
.login-backdrop{position:fixed;left:0;right:0;top:0;bottom:0;z-index:0}
.login-bg{position:absolute;left:0;right:0;top:0;bottom:0;width:100%;height:100%;transform:scale(1.08)}
.login-shade{position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(180deg,rgba(0,0,0,.42),rgba(5,17,13,.42) 44%,rgba(0,0,0,.96))}
.login-content{position:relative;z-index:5;min-height:calc(100vh - 20px);padding:62rpx 46rpx calc(86rpx + constant(safe-area-inset-bottom));padding:62rpx 46rpx calc(86rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box}
.brand-block{padding-top:38rpx}
.brand-mark{width:96rpx;height:96rpx;border-radius:50%;border:1rpx solid rgba(16,185,129,.36);display:flex;align-items:center;justify-content:center;margin-bottom:28rpx;background:rgba(6,78,59,.13);box-shadow:0 0 60rpx rgba(16,185,129,.25)}
.brand-mark view{width:66rpx;height:66rpx;border:7rpx solid rgba(52,211,153,.85);border-radius:50%}
.brand-name{display:block;color:#fff;font-size:78rpx;font-weight:300;line-height:1.05;letter-spacing:0}
.brand-subtitle{display:block;margin-top:16rpx;color:#34d399;font-size:27rpx;font-weight: 500;letter-spacing:4rpx;text-transform:uppercase;line-height:1.45}
.login-form{position:relative;z-index:6;padding:8rpx;border-radius:36rpx;background:rgba(0,0,0,.12);backdrop-filter:blur(18rpx)}
.login-form empty-state{display:block;margin-bottom:24rpx}
.mode-tabs{display:flex;height:74rpx;margin-bottom:18rpx;padding:6rpx;border-radius:28rpx;background:rgba(255,255,255,.08);gap:6rpx}
.mode-tab{flex:1;display:flex;align-items:center;justify-content:center;border-radius:22rpx;color:rgba(255,255,255,.58);font-size:26rpx;font-weight: 500}
.mode-tab-on{background:rgba(5,150,105,.88);color:#fff}
.field{position:relative;height:88rpx;margin-bottom:18rpx;display:flex;align-items:center;border-radius:26rpx;border:1rpx solid rgba(255,255,255,.11);background:rgba(0,0,0,.24);box-shadow:inset 0 2rpx 20rpx rgba(0,0,0,.12)}
.field input{flex:1;min-width:0;height:100%;padding:0 30rpx;color:#fff;font-size:28rpx}
.field-icon{width:92rpx;color:rgba(209,250,229,.45);text-align:center;font-size:24rpx;font-weight: 500}
.placeholder{color:rgba(255,255,255,.34)}
.eye{position:absolute;right:38rpx;top:50%;z-index:7;display:flex;align-items:center;justify-content:center;padding:0;color:rgba(255,255,255,.42);font-size:24rpx;line-height:1;transform:translateY(-50%);background:transparent}
.primary{position:relative;z-index:7;width:100%;min-width:0;height:92rpx;margin-top:22rpx;display:flex;align-items:center;justify-content:center;gap:18rpx;border-radius:28rpx;color:#fff;font-size:30rpx;font-weight: 500;letter-spacing:1rpx;background:linear-gradient(90deg,#059669,#0f766e);box-shadow:0 20rpx 44rpx rgba(6,95,70,.28)}
.primary-hover{opacity:.92;transform:scale(.99)}
.secondary{position:relative;z-index:7;width:100%;min-width:0;height:78rpx;margin-top:16rpx;display:flex;align-items:center;justify-content:center;border-radius:26rpx;color:rgba(209,250,229,.82);font-size:26rpx;font-weight: 500;background:rgba(255,255,255,.08)}
.secondary-hover{opacity:.9}
.link-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;flex-wrap:wrap;padding:24rpx 12rpx 4rpx;color:rgba(209,250,229,.5);font-size:24rpx;line-height:1.45}
.agreement-row{display:flex;align-items:flex-start;gap:18rpx;padding:24rpx 12rpx 0;color:rgba(255,255,255,.72)}
.agreement-check{flex:0 0 auto;width:34rpx;height:34rpx;margin-top:3rpx;border-radius:8rpx;border:1rpx solid rgba(209,250,229,.55);text-align:center;line-height:34rpx;font-size:22rpx;color:#fff}
.agreement-check-on{background:#059669;border-color:#34d399}
.agreement-copy{flex:1;min-width:0;font-size:23rpx;line-height:1.55}
.agreement-link{color:#6ee7b7}
.home-indicator{position:fixed;z-index:4;left:50%;bottom:14rpx;bottom:calc(14rpx + constant(safe-area-inset-bottom));bottom:calc(14rpx + env(safe-area-inset-bottom));width:220rpx;height:8rpx;transform:translateX(-50%);border-radius:999rpx;background:rgba(255,255,255,.22)}
