<view class="legal-page">
  <view class="legal-header" style="padding-top: {{headerTop}}px;">
    <text class="legal-title">{{copy.agreementTitle}}</text>
  </view>
  <scroll-view scroll-y="true" class="legal-scroll">
    <view class="legal-card">
      <text class="legal-heading">{{copy.agreementHeading}}</text>
      <text class="legal-meta">{{copy.meta}}</text>
      <block wx:for="{{copy.agreementParagraphs}}" wx:key="*this"><text class="legal-p">{{item}}</text></block>
    </view>
  </scroll-view>
  <view class="legal-footer">
    <button class="back-btn" bindtap="goBack">{{copy.back}}</button>
  </view>
</view>
