.legal-page{height:100vh;background:#050706;color:#f8fafc;display:flex;flex-direction:column;overflow:hidden}
.legal-header{padding:0 34rpx 22rpx;box-sizing:border-box;border-bottom:1rpx solid rgba(255,255,255,.08);flex:none}
.legal-title{display:block;text-align:center;line-height:48rpx;font-size:32rpx;font-weight: 500}
.legal-scroll{flex:1;min-height:0}
.legal-card{padding:36rpx 34rpx}
.legal-heading{display:block;font-size:38rpx;font-weight: 500;margin-bottom:12rpx;color:#ffffff}
.legal-meta{display:block;font-size:22rpx;color:rgba(255,255,255,.45);margin-bottom:30rpx}
.legal-p{display:block;margin-bottom:24rpx;font-size:28rpx;line-height:1.75;color:rgba(255,255,255,.84)}
.legal-footer{flex:none;padding:20rpx 34rpx 28rpx;box-sizing:border-box;border-top:1rpx solid rgba(255,255,255,.08);background:rgba(5,7,6,.96);padding-bottom:calc(28rpx + constant(safe-area-inset-bottom));padding-bottom:calc(28rpx + env(safe-area-inset-bottom))}
.back-btn{width:100%;height:88rpx;line-height:88rpx;border-radius:16rpx;background:#14231e;color:#d1fae5;font-size:28rpx;font-weight: 500}
.back-btn::after{border:0}
