.legal-page{min-height:100vh;background:#050706;color:#f8fafc}
.legal-header{height:132rpx;padding:54rpx 28rpx 0;box-sizing:border-box;border-bottom:1rpx solid rgba(255,255,255,.08)}
.back-btn{float:left;width:108rpx;height:56rpx;line-height:56rpx;border-radius:12rpx;background:#14231e;color:#d1fae5;font-size:24rpx}
.legal-title{display:block;text-align:center;line-height:56rpx;font-size:32rpx;font-weight:600}
.legal-scroll{height:calc(100vh - 132rpx)}
.legal-card{padding:36rpx 34rpx 80rpx}
.legal-heading{display:block;font-size:38rpx;font-weight:700;margin-bottom:12rpx;color:#ffffff}
.legal-meta{display:block;font-size:22rpx;color:rgba(255,255,255,.45);margin-bottom:30rpx}
.legal-p{display:block;margin-bottom:24rpx;font-size:28rpx;line-height:1.75;color:rgba(255,255,255,.84)}
