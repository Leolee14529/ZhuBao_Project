NODE_ENV=development
PORT=3000

# Required in production.
DATABASE_URL=postgresql://zhubao:change-me@127.0.0.1:5432/zhubao
DATABASE_SSL=false
WECHAT_APPID=replace-with-wechat-appid
WECHAT_SECRET=replace-with-wechat-secret

# Comma-separated browser origins. Requests without an Origin header remain valid
# for WeChat Mini Program clients.
CORS_ORIGINS=https://your-web-domain.example

# Development only. Production never enables mock login.
WECHAT_MOCK_LOGIN=true
ZHUBAO_DATA_DIR=
