.products-page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background-color: #050806;
  background-image:
    radial-gradient(circle at 16% 0%, rgba(57, 216, 122, 0.15), transparent 34%),
    linear-gradient(180deg, #06100b 0%, #050806 42%, #030504 100%);
  color: #ffffff;
}

.page-back-button {
  position: fixed !important;
  left: 0 !important;
  width: 88rpx;
  height: 88rpx;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  transform: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 1000;
}

.page-back-chevron {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.products-body {
  min-height: 100%;
  padding: 34rpx 32rpx 0;
}

.products-scroll { height: 100%; }
.page-top-spacer { width: 100%; }

.topbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 74rpx;
  margin-bottom: 26rpx;
}

.topbar-leading {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
}

.icon-button {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  border-radius: 31rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
}

.title-block {
  flex: 1;
  min-width: 0;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.1;
  color: #ffffff;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.46);
}

.search-ring {
  position: absolute;
  left: 20rpx;
  top: 18rpx;
  width: 21rpx;
  height: 21rpx;
  border: 3rpx solid rgba(57, 216, 122, 0.86);
  border-radius: 50%;
}

.search-line {
  position: absolute;
  left: 40rpx;
  top: 39rpx;
  width: 15rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(57, 216, 122, 0.86);
  transform: rotate(45deg);
}

.feature-band {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 172rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(57, 216, 122, 0.22);
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(9, 33, 24, 0.96), rgba(2, 8, 6, 0.92)),
    radial-gradient(circle at 78% 18%, rgba(232, 217, 181, 0.18), transparent 38%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.feature-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0;
  color: rgba(57, 216, 122, 0.82);
}

.feature-title {
  display: block;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.18;
  color: #ffffff;
}

.feature-stats {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding-bottom: 2rpx;
}

.feature-number {
  font-size: 52rpx;
  line-height: 1;
  color: #39d87a;
}

.feature-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.54);
}

.filter-scroll {
  width: 100%;
  margin-bottom: 26rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 14rpx;
  min-width: 100%;
}

.filter-pill {
  display: inline-block;
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 27rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.055);
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
}

.icon-button::after,
.filter-pill::after { border: 0; }

.filter-pill-active {
  border-color: rgba(57, 216, 122, 0.62);
  background: rgba(57, 216, 122, 0.16);
  color: #39d87a;
}

.product-waterfall {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
}

.waterfall-right {
  padding-top: 34rpx;
}

.product-tile {
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
  background: rgba(8, 10, 10, 0.96);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.22);
}

.product-image-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #101413;
}

.product-card-xl .product-image-wrap {
  height: 410rpx;
}
.product-card-tall .product-image-wrap {
  height: 360rpx;
}
.product-card-medium .product-image-wrap {
  height: 306rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}
.image-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42%;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.62));
}

.product-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  max-width: 148rpx;
  padding: 6rpx 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(57, 216, 122, 0.92);
  color: #04160c;
  font-size: 20rpx;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-info {
  padding: 18rpx 18rpx 20rpx;
}
.product-name {
  display: block;
  color: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.32;
}

.product-type {
  display: block;
  margin-top: 8rpx;
  color: rgba(57, 216, 122, 0.68);
  font-size: 20rpx;
  line-height: 1.32;
}

.product-desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 20rpx;
  line-height: 1.5;
  word-break: break-word;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}

.product-more {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.safe-bottom-space {
  height: 88rpx;
}
