.products-page{height:100vh;min-height:100vh;overflow:hidden;background:radial-gradient(circle at 16% 0%,rgba(57,216,122,.13),transparent 34%),linear-gradient(180deg,#06100b 0%,#050806 42%,#030504 100%);color:#fff}.products-scroll{height:100%}.products-body{min-height:100%;padding:0 32rpx;box-sizing:border-box}.page-top-spacer{width:100%}
.topbar{display:flex;align-items:center;gap:20rpx;min-height:88rpx;margin:24rpx 0 26rpx}.icon-button{position:relative;flex:0 0 80rpx;width:80rpx;height:80rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:40rpx;background:rgba(255,255,255,.055)}.icon-button::after{border:0}.back-chevron{position:absolute;left:31rpx;top:27rpx;width:20rpx;height:20rpx;border-left:3rpx solid rgba(255,255,255,.92);border-bottom:3rpx solid rgba(255,255,255,.92);transform:rotate(45deg)}.title-block{flex:1;min-width:0}.page-title,.page-subtitle{display:block}.page-title{font-size:40rpx;font-weight:600;line-height:1.15}.page-subtitle{margin-top:8rpx;color:rgba(255,255,255,.5);font-size:23rpx;line-height:1.4}.search-ring{position:absolute;left:25rpx;top:23rpx;width:24rpx;height:24rpx;border:3rpx solid #43d896;border-radius:50%}.search-line{position:absolute;left:48rpx;top:48rpx;width:17rpx;height:3rpx;border-radius:2rpx;background:#43d896;transform:rotate(45deg)}
.search-panel{display:flex;align-items:center;gap:14rpx;margin-bottom:22rpx;padding:12rpx 12rpx 12rpx 22rpx;border:1rpx solid rgba(57,216,122,.2);border-radius:22rpx;background:rgba(7,22,16,.94)}.search-input{flex:1;min-width:0;height:68rpx;color:#fff;font-size:26rpx}.search-placeholder{color:rgba(255,255,255,.34)}.search-clear{flex:none;min-width:88rpx;height:68rpx;padding:0 18rpx;border-radius:16rpx;background:rgba(57,216,122,.12);color:#64dfa8;font-size:22rpx;line-height:68rpx}.search-clear::after{border:0}
.feature-band{min-height:172rpx;padding:28rpx;margin-bottom:24rpx;border:1rpx solid rgba(57,216,122,.24);border-radius:28rpx;background:linear-gradient(135deg,rgba(9,33,24,.98),rgba(2,8,6,.94));box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.025);box-sizing:border-box}.feature-kicker,.feature-title{display:block}.feature-kicker{color:rgba(57,216,122,.82);font-size:20rpx;letter-spacing:1rpx}.feature-title{margin-top:20rpx;color:#fff;font-size:40rpx;font-weight:600;line-height:1.2}
.filter-scroll{width:100%;margin-bottom:22rpx;white-space:nowrap}.filter-row{display:inline-flex;gap:14rpx;min-width:100%}.filter-pill{display:inline-flex;align-items:center;justify-content:center;min-width:112rpx;min-height:88rpx;padding:0 28rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:44rpx;background:rgba(255,255,255,.05);color:rgba(255,255,255,.68);font-size:23rpx;line-height:1.35;text-align:center;box-sizing:border-box}.filter-pill::after{border:0}.filter-pill-active{border-color:rgba(57,216,122,.65);background:rgba(57,216,122,.15);color:#51dea1}
.mood-filter-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:8rpx 24rpx;min-height:60rpx;margin:4rpx 0 10rpx}.mood-filter-title{flex:1 1 360rpx;min-width:0;color:rgba(255,255,255,.92);font-size:28rpx;font-weight:600;line-height:1.4;word-break:break-word}.mood-filter-hint{flex:0 0 auto;margin-left:auto;color:rgba(79,222,158,.64);font-size:20rpx;line-height:1.4;text-align:right}.mood-scroll{width:100%;margin-bottom:30rpx;white-space:nowrap}.mood-row{display:inline-flex;gap:12rpx;min-width:100%}.mood-pill{display:inline-flex;align-items:center;justify-content:center;min-width:126rpx;min-height:88rpx;padding:0 26rpx;border:1rpx solid rgba(57,216,122,.16);border-radius:22rpx;background:linear-gradient(145deg,rgba(20,47,35,.7),rgba(8,14,11,.9));color:rgba(255,255,255,.66);font-size:23rpx;line-height:1.35;text-align:center;box-sizing:border-box}.mood-pill::after{border:0}.mood-pill-active{border-color:rgba(83,229,164,.72);background:linear-gradient(145deg,rgba(45,145,95,.34),rgba(12,34,24,.98));color:#72e7b0;box-shadow:inset 0 0 0 1rpx rgba(83,229,164,.08)}
.product-waterfall{display:flex;align-items:flex-start;gap:20rpx}.waterfall-col{flex:1;min-width:0}.waterfall-right{padding-top:34rpx}.product-tile{overflow:hidden;margin-bottom:24rpx;border:1rpx solid rgba(255,255,255,.08);border-radius:24rpx;background:rgba(8,10,10,.98);box-shadow:0 22rpx 60rpx rgba(0,0,0,.22);transition:opacity 160ms ease,transform 160ms ease}.product-tile-pressed{opacity:.82;transform:scale(.985)}.product-image-wrap{position:relative;width:100%;overflow:hidden;background:#101413}.product-card-xl .product-image-wrap{height:410rpx}.product-card-tall .product-image-wrap{height:360rpx}.product-card-medium .product-image-wrap{height:306rpx}.product-image{display:block;width:100%;height:100%}.image-shade{position:absolute;left:0;right:0;bottom:0;height:42%;background:linear-gradient(180deg,transparent,rgba(0,0,0,.58))}.product-badge{position:absolute;left:16rpx;top:16rpx;max-width:150rpx;padding:7rpx 16rpx;overflow:hidden;border-radius:999rpx;background:#39d87a;color:#04160c;font-size:20rpx;line-height:1.25;white-space:nowrap;text-overflow:ellipsis}
.product-info{padding:20rpx 18rpx 22rpx}.product-name,.product-type,.product-desc{display:block}.product-name{color:rgba(255,255,255,.96);font-size:28rpx;font-weight:600;line-height:1.35;word-break:break-word}.product-type{margin-top:8rpx;color:rgba(74,224,157,.78);font-size:20rpx;line-height:1.45}.product-desc{margin-top:10rpx;color:rgba(255,255,255,.52);font-size:21rpx;line-height:1.55;word-break:break-word}.product-more{display:inline-flex;align-items:center;max-width:100%;margin-top:16rpx;padding:8rpx 15rpx;border-radius:18rpx;background:rgba(255,255,255,.07);color:rgba(255,255,255,.72);font-size:20rpx;line-height:1.35;box-sizing:border-box}.empty-panel{padding:64rpx 30rpx;border:1rpx solid rgba(255,255,255,.07);border-radius:24rpx;background:rgba(255,255,255,.035);color:rgba(255,255,255,.52);font-size:25rpx;line-height:1.6;text-align:center}.safe-bottom-space{height:calc(86rpx + env(safe-area-inset-bottom))}
