<view class="settings-page">
  <view class="scroll-container">
    <scroll-view class="settings-scroll" scroll-y="true">
      <view class="page-body">
        <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>

        <view class="profile-head">
          <view class="profile-avatar">
            <text class="avatar-letter">{{avatarLetter}}</text>
          </view>
          <view class="profile-copy">
            <text class="profile-title">{{profileTitle}}</text>
            <view class="profile-subtitle-row">
              <text class="profile-subtitle">暂无设备型号</text>
              <view class="profile-subtitle-dot"></view>
              <text class="profile-subtitle">暂无设备版本</text>
            </view>
          </view>
        </view>

        <block wx:for="{{sections}}" wx:key="title">
          <view class="section">
            <text class="section-title">{{item.title}}</text>
            <view class="section-card">
              <block wx:for="{{item.items}}" wx:key="label">
                <view
                  class="setting-row {{item.rowClass}}"
                  data-is-language="{{item.isLanguage}}"
                  data-is-ring="{{item.isRing}}"
                  bindtap="onSettingRowTap"
                >
                  <view class="row-left">
                    <text class="row-label">{{item.label}}</text>
                  </view>
                  <view class="row-right">
                    <text wx:if="{{item.isLanguage}}" class="row-value {{item.valueClass}}">{{currentLanguage}}</text>
                    <text wx:elif="{{item.isRing}}" class="row-value {{item.valueClass}}">{{isDeviceBound ? '已连接' : '未连接'}}</text>
                    <text wx:elif="{{item.value}}" class="row-value {{item.valueClass}}">{{item.value}}</text>
                    <view
                      wx:if="{{item.toggle}}"
                      class="toggle {{item.isSleep ? (sleepEnabled ? 'toggle-on' : 'toggle-off') : ''}}{{item.isBell ? (notificationsEnabled ? ' toggle-on' : ' toggle-off') : ''}}"
                      data-key="{{item.isSleep ? 'sleepEnabled' : (item.isBell ? 'notificationsEnabled' : '')}}"
                      catchtap="onToggleTap"
                      bindtouchstart="onToggleTouchStart"
                      bindtouchend="onToggleTouchEnd"
                    >
                      <view class="toggle-knob"></view>
                    </view>
                    <text wx:if="{{item.arrow}}" class="row-arrow">></text>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </block>

        <view class="section">
          <text class="section-title">PRIVACY</text>
          <view class="section-card">
            <view class="setting-row" bindtap="openAgreement">
              <view class="row-left"><text class="row-label">用户协议</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="openPrivacy">
              <view class="row-left"><text class="row-label">隐私政策</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="openWechatPrivacy">
              <view class="row-left"><text class="row-label">微信隐私保护指引</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="clearCycleData">
              <view class="row-left"><text class="row-label">清除周期本地数据</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="withdrawConsent">
              <view class="row-left"><text class="row-label">撤回同意</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row setting-row-last danger-row" bindtap="deleteAccount">
              <view class="row-left"><text class="row-label danger-label">注销账号并删除服务器数据</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
          </view>
        </view>

        <button class="logout-btn" bindtap="logout" loading="{{isLoggingOut}}" disabled="{{isLoggingOut}}">
          <view class="logout-inner">
            <view class="logout-icon">
              <view class="logout-door"></view>
              <view class="logout-arrow"></view>
              <view class="logout-arrow-head"></view>
            </view>
            <text class="logout-text">退出登录</text>
          </view>
        </button>

        <text class="version-text">0.0.1 Build A</text>
        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>

  <bottom-nav active="settings"></bottom-nav>
</view>
