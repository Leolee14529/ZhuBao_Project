<view class="settings-page">
  <view class="scroll-container">
    <scroll-view class="settings-scroll" scroll-y="true">
      <view class="page-body">
        <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>

        <view class="profile-head">
          <view class="profile-avatar">
            <text class="avatar-letter">{{avatarLetter}}</text>
          </view>
          <view class="profile-copy">
            <text class="profile-title">{{profileTitle}}</text>
            <view class="profile-subtitle-row">
              <text class="profile-subtitle">{{copy.noDeviceModel}}</text>
              <view class="profile-subtitle-dot"></view>
              <text class="profile-subtitle">{{copy.noDeviceVersion}}</text>
            </view>
          </view>
        </view>

        <block wx:for="{{sections}}" wx:key="id">
          <view class="section">
            <text class="section-title">{{item.title}}</text>
            <view class="section-card">
              <block wx:for="{{item.items}}" wx:key="id">
                <view
                  class="setting-row {{item.rowClass}}"
                  data-is-language="{{item.isLanguage}}"
                  data-is-ring="{{item.isRing}}"
                  bindtap="onSettingRowTap"
                >
                  <view class="row-left">
                    <text class="row-label">{{item.label}}</text>
                  </view>
                  <view class="row-right">
                    <text wx:if="{{item.isLanguage}}" class="row-value {{item.valueClass}}">{{currentLanguage}}</text>
                    <text wx:elif="{{item.isRing}}" class="row-value {{item.valueClass}}">{{ringStatus}}</text>
                    <text wx:elif="{{item.value}}" class="row-value {{item.valueClass}}">{{item.value}}</text>
                    <text wx:if="{{item.arrow}}" class="row-arrow">></text>
                  </view>
                </view>
                <view wx:if="{{item.isLanguage && languageExpanded}}" class="language-options">
                  <view class="language-option" data-locale="zh-CN" catchtap="selectLanguage">
                    <text class="language-option__text">{{copy.chinese}}</text>
                    <text wx:if="{{locale === 'zh-CN'}}" class="language-option__check">✓</text>
                  </view>
                  <view class="language-option language-option-last" data-locale="en-US" catchtap="selectLanguage">
                    <text class="language-option__text">{{copy.english}}</text>
                    <text wx:if="{{locale === 'en-US'}}" class="language-option__check">✓</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </block>

        <view class="section">
          <text class="section-title">{{copy.privacy}}</text>
          <view class="section-card">
            <view class="setting-row" bindtap="openAgreement">
              <view class="row-left"><text class="row-label">{{copy.agreement}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="openPrivacy">
              <view class="row-left"><text class="row-label">{{copy.privacyPolicy}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="openWechatPrivacy">
              <view class="row-left"><text class="row-label">{{copy.wechatPrivacy}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="clearCycleData">
              <view class="row-left"><text class="row-label">{{copy.clearCycle}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="deleteWuxingProfile">
              <view class="row-left"><text class="row-label">{{copy.deleteBirth}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row" bindtap="withdrawConsent">
              <view class="row-left"><text class="row-label">{{copy.withdrawConsent}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
            <view class="setting-row setting-row-last danger-row" bindtap="deleteAccount">
              <view class="row-left"><text class="row-label danger-label">{{copy.deleteAccount}}</text></view>
              <view class="row-right"><text class="row-arrow">></text></view>
            </view>
          </view>
        </view>

        <button class="logout-btn" bindtap="logout" loading="{{isLoggingOut}}" disabled="{{isLoggingOut}}">
          <view class="logout-inner">
            <view class="logout-icon">
              <view class="logout-door"></view>
              <view class="logout-arrow"></view>
              <view class="logout-arrow-head"></view>
            </view>
            <text class="logout-text">{{copy.logout}}</text>
          </view>
        </button>

        <text class="version-text">0.0.1 Build A</text>
        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>

  <bottom-nav active="settings"></bottom-nav>
</view>
