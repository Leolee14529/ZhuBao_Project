.home-page {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  background-color: #050806;
  color: #ffffff;
  overflow: hidden;
}

.scroll-container {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.home-scroll {
  height: 100%;
  background-color: #050806;
}

.page-body {
  min-height: 100%;
  padding: 54rpx 40rpx 240rpx;
}

.page-top-spacer {
  width: 100%;
}

.page-header {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.header-copy {
  float: left;
  padding-top: 12rpx;
}

.hello-line {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.destiny-line {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.46);
}

.capsule-action {
  float: right;
  height: 58rpx;
  padding: 0 18rpx;
  margin-top: 10rpx;
  border-radius: 29rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  line-height: 58rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
}

.capsule-divider {
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.3);
}

.divination-card {
  position: relative;
  overflow: hidden;
  min-height: 610rpx;
  margin-bottom: 44rpx;
  border-radius: 34rpx;
  background-color: #0f1714;
  border: 1rpx solid rgba(16, 185, 129, 0.22);
}

.divination-front {
  display: block;
  padding: 30rpx 42rpx 42rpx;
}

.divination-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.12;
  background-image: linear-gradient(rgba(16, 185, 129, 0.2) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(16, 185, 129, 0.2) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
}

.divination-head {
  position: relative;
  overflow: hidden;
  margin-bottom: 76rpx;
}

.divination-label {
  float: left;
  font-size: 26rpx;
  color: #39d87a;
}

.divination-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background-color: #39d87a;
}

.divination-no {
  float: right;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.34);
}

.divination-center {
  position: relative;
  text-align: center;
  margin-bottom: 56rpx;
}

.divination-ring {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  margin: 0 auto 28rpx;
  border-radius: 92rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.28);
}

.divination-ring-inner {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  border-radius: 68rpx;
  border: 4rpx solid rgba(57, 216, 122, 0.8);
}

.divination-symbol {
  display: block;
  line-height: 184rpx;
  text-align: center;
  font-size: 82rpx;
  color: #ffffff;
}

.divination-title {
  display: block;
  font-size: 56rpx;
  color: #ffffff;
}

.divination-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.divination-copy {
  position: relative;
  min-height: 150rpx;
  padding: 30rpx 30rpx 28rpx 70rpx;
  border-radius: 24rpx;
  background-color: rgba(0, 0, 0, 0.34);
}

.divination-quote {
  position: absolute;
  left: 34rpx;
  top: 28rpx;
  font-size: 44rpx;
  color: #39d87a;
}

.divination-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(220, 252, 231, 0.92);
}

.divination-back {
  display: none;
  position: relative;
  min-height: 610rpx;
  padding-top: 180rpx;
  text-align: center;
  background-color: #0a120f;
}

.divination-card-flipped .divination-front {
  display: none;
}

.divination-card-flipped .divination-back {
  display: block;
}

.divination-back-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
  background-image: linear-gradient(rgba(16, 185, 129, 0.22) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(16, 185, 129, 0.22) 1rpx, transparent 1rpx);
  background-size: 50rpx 50rpx;
}

.divination-back-core {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border: 2rpx solid rgba(57, 216, 122, 0.4);
  transform: rotate(45deg);
}

.divination-back-title {
  display: block;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: rgba(57, 216, 122, 0.75);
}

.divination-back-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.26);
}

.stats-row {
  overflow: hidden;
  margin-bottom: 30rpx;
}

.home-page device-card {
  display: block;
  margin-bottom: 30rpx;
}

.stat-card {
  width: 320rpx;
  min-height: 148rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background-color: #171920;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.stat-left {
  float: left;
}

.stat-right {
  float: right;
}

.stat-caption {
  display: block;
  font-size: 18rpx;
  color: #8db8ff;
}

.stat-pink {
  color: #ff7aa8;
}

.stat-value {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.48);
}

.section-head {
  overflow: hidden;
  margin-bottom: 26rpx;
}

.section-title {
  float: left;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-link {
  float: right;
  margin-top: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background-color: rgba(0, 185, 120, 0.16);
  font-size: 22rpx;
  font-weight: 500;
  color: #39d87a;
}

.gallery {
  overflow: hidden;
}

.gallery-col {
  width: 320rpx;
}

.gallery-col-left {
  float: left;
}

.gallery-col-right {
  float: right;
}

.product-card {
  position: relative;
  overflow: hidden;
  width: 320rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background-color: #1a1d24;
}

.product-card-tall {
  height: 398rpx;
}

.product-card-short {
  height: 260rpx;
}

.product-image {
  width: 320rpx;
  height: 100%;
}

.product-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background-color: #39d87a;
  color: #052611;
  font-size: 18rpx;
  font-weight: 700;
}

.custom-card {
  overflow: hidden;
  margin-top: 34rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.24);
  background-color: rgba(0, 95, 68, 0.72);
}

.custom-icon {
  float: left;
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: rgba(57, 216, 122, 0.14);
  color: #39d87a;
  text-align: center;
  line-height: 76rpx;
  font-size: 18rpx;
}

.custom-copy {
  float: left;
  margin-left: 24rpx;
}

.custom-title {
  display: block;
  font-size: 32rpx;
  color: #ffffff;
}

.custom-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.44);
}

.custom-arrow {
  float: right;
  margin-top: 8rpx;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.54);
}

.bottom-space {
  height: 70rpx;
}

.tabbar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  height: 104rpx;
  padding-top: 12rpx;
  border-radius: 28rpx;
  background-color: rgba(18, 18, 20, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab-item {
  float: left;
  width: 238rpx;
  text-align: center;
  padding-top: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

.tab-text {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.tab-item-active {
  color: #39d87a;
}

.tab-text-muted {
  color: rgba(255, 255, 255, 0.4);
}
