.home-page {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  background-color: #050806;
  color: #ffffff;
  overflow: hidden;
}

.scroll-container {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.home-scroll {
  height: 100%;
  background-color: #050806;
}

.page-body {
  min-height: 100%;
  padding: 54rpx 40rpx 240rpx;
}

.page-top-spacer {
  width: 100%;
}

.page-header {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.header-copy {
  float: left;
  padding-top: 12rpx;
}

.hello-line {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.destiny-line {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.46);
}

.capsule-action {
  float: right;
  height: 58rpx;
  padding: 0 18rpx;
  margin-top: 10rpx;
  border-radius: 29rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  line-height: 58rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
}

.capsule-divider {
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.3);
}

.stats-row {
  overflow: hidden;
  margin-bottom: 30rpx;
}

.home-page device-card {
  display: block;
  margin-bottom: 30rpx;
}

.stat-card {
  width: 320rpx;
  min-height: 148rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background-color: #171920;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.stat-left {
  float: left;
}

.stat-right {
  float: right;
}

.stat-caption {
  display: block;
  font-size: 18rpx;
  color: #8db8ff;
}

.stat-pink {
  color: #ff7aa8;
}

.stat-value {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.48);
}

.section-head {
  overflow: hidden;
  margin-bottom: 26rpx;
}

.section-title {
  float: left;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-link {
  float: right;
  margin-top: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background-color: rgba(0, 185, 120, 0.16);
  font-size: 22rpx;
  font-weight: 500;
  color: #39d87a;
}

.gallery {
  overflow: hidden;
}

.gallery-col {
  width: 320rpx;
}

.gallery-col-left {
  float: left;
}

.gallery-col-right {
  float: right;
}

.product-card {
  position: relative;
  overflow: hidden;
  width: 320rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background-color: #1a1d24;
}

.product-card-tall {
  height: 398rpx;
}

.product-card-short {
  height: 260rpx;
}

.product-image {
  width: 320rpx;
  height: 100%;
}

.product-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background-color: #39d87a;
  color: #052611;
  font-size: 18rpx;
  font-weight: 700;
}

.custom-card {
  overflow: hidden;
  margin-top: 34rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.24);
  background-color: rgba(0, 95, 68, 0.72);
}

.custom-icon {
  float: left;
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: rgba(57, 216, 122, 0.14);
  color: #39d87a;
  text-align: center;
  line-height: 76rpx;
  font-size: 18rpx;
}

.custom-copy {
  float: left;
  margin-left: 24rpx;
}

.custom-title {
  display: block;
  font-size: 32rpx;
  color: #ffffff;
}

.custom-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.44);
}

.custom-arrow {
  float: right;
  margin-top: 8rpx;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.54);
}

.bottom-space {
  height: 70rpx;
}
