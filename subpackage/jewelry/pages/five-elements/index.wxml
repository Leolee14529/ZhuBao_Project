<view class="customize-page">
  <scroll-view class="customize-scroll" scroll-y="true">
    <view class="page-body">
      <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>

      <view class="topbar">
        <view class="back-button" bindtap="goBack">
          <text class="back-arrow">‹</text>
        </view>
        <text class="topbar-title">{{copy.title}}</text>
      </view>

      <view class="intro-card">
        <text class="intro-title">{{copy.introTitle}}</text>
        <text class="intro-desc">{{copy.introDesc}}</text>
      </view>

      <view class="form-card">
        <picker mode="date" value="{{birthDate}}" start="1950-01-01" end="2035-12-31" bindchange="onDateChange">
          <view class="field-row">
            <view class="field-copy">
              <text class="field-label">{{copy.birthDate}}</text>
              <text class="field-value">{{birthDate}}</text>
            </view>
            <text class="field-arrow">›</text>
          </view>
        </picker>

        <picker mode="time" value="{{birthTime}}" bindchange="onTimeChange">
          <view class="field-row">
            <view class="field-copy">
              <text class="field-label">{{copy.birthTime}}</text>
              <text class="field-value">{{birthTime}}</text>
            </view>
            <text class="field-arrow">›</text>
          </view>
        </picker>

        <picker value="{{genderIndex}}" range="{{genderOptions}}" bindchange="onGenderChange">
          <view class="field-row field-row-last">
            <view class="field-copy">
              <text class="field-label">{{copy.gender}}</text>
              <text class="field-value">{{genderOptions[genderIndex]}}</text>
            </view>
            <text class="field-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="preview-card">
        <text class="preview-title">{{copy.preview}}</text>
        <text class="preview-focus">{{focusLabel}}</text>
        <text class="preview-desc">{{destinyLine}}</text>
        <view class="tags">
          <block wx:for="{{previewTags}}" wx:key="key">
            <view class="tag-item" style="border-color: {{item.color}}; color: {{item.color}};">
              <text>{{item.label}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="save-button-row">
        <button
          class="save-button"
          bindtap="saveBirthProfile"
          loading="{{isSaving}}"
          disabled="{{isSaving}}"
        >{{isSaving ? commonSaving : (isLoggedIn ? copy.saveLoggedIn : copy.saveGuest)}}</button>
      </view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>
