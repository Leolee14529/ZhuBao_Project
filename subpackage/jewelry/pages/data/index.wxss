.data-page{min-height:100%;background-color:#121319;color:#ffffff}
.data-scroll{height:100vh;background-color:#121319}
.page-body{padding:34rpx 24rpx 176rpx}
.page-top-spacer{width:100%}
.page-header{margin-bottom:28rpx}
.page-title{display:block;font-size:38rpx;font-weight:300;color:#ffffff}
.page-subtitle{display:block;margin-top:10rpx;font-size:22rpx;letter-spacing:4rpx;color:#39d87a}
.score-card{overflow:hidden;padding:32rpx 30rpx 30rpx;margin-bottom:28rpx;border-radius:30rpx;border:1rpx solid rgba(57,216,122,.22);background-color:#151d1a}
.score-copy{float:left;width:360rpx}
.score-label-row{overflow:hidden}
.score-dot{float:left;width:10rpx;height:10rpx;margin-top:9rpx;margin-right:10rpx;border-radius:5rpx;background-color:#39d87a}
.score-label{float:left;font-size:20rpx;letter-spacing:2rpx;color:rgba(57,216,122,.82)}
.score-value{display:block;margin-top:16rpx;font-size:54rpx;font-weight:300;color:#ffffff}
.score-unit{font-size:26rpx;color:rgba(255,255,255,.42)}
.score-text{display:block;max-width:300rpx;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:rgba(255,255,255,.48)}
.score-ring{float:right;width:144rpx;height:144rpx;padding:12rpx;border-radius:72rpx;border:12rpx solid #10b981;background-color:rgba(16,185,129,.12)}
.score-ring-inner{width:96rpx;height:96rpx;border-radius:48rpx;background-color:#08100d;text-align:center;line-height:96rpx;color:#39d87a;font-size:38rpx}
.period-entry{display:flex;align-items:center;justify-content:center;position:relative;height:112rpx;margin-bottom:28rpx;border-radius:28rpx;border:1rpx solid rgba(57,216,122,.4);background:linear-gradient(180deg,rgba(16,29,23,.98),rgba(12,22,18,.98));box-shadow:0 0 0 1rpx rgba(57,216,122,.08) inset}
.period-entry-title{font-size:28rpx;font-weight:500;letter-spacing:2rpx;color:#14e29a}
.period-entry-arrow{position:absolute;right:34rpx;top:50%;transform:translateY(-50%);font-size:44rpx;line-height:1;color:#14e29a}
.key-stats{overflow:hidden;margin-bottom:28rpx}
.key-stat{float:left;width:338rpx;padding:24rpx;border-radius:24rpx;background-color:#171920;border:1rpx solid rgba(255,255,255,.07)}
.key-stat-left{float:left}
.key-stat-right{float:right}
.key-stat-icon{float:left;width:56rpx;height:56rpx;border-radius:28rpx;line-height:56rpx;text-align:center;font-size:24rpx;background-color:rgba(255,255,255,.06)}
.icon-rose{color:#fb7185}
.icon-green{color:#39d87a}
.key-stat-copy{float:left;margin-left:16rpx}
.key-stat-value{display:block;font-size:38rpx;font-weight:300;color:#ffffff}
.small-unit{font-size:20rpx;color:rgba(255,255,255,.34)}
.key-stat-label{display:block;margin-top:6rpx;font-size:20rpx;color:rgba(255,255,255,.44)}
.panel{margin-bottom:28rpx;padding:28rpx;border-radius:28rpx;background-color:#171920;border:1rpx solid rgba(255,255,255,.06)}
.panel-title{display:block;font-size:30rpx;color:#ffffff}
.panel-subtitle{display:block;margin-top:8rpx;font-size:20rpx;color:rgba(255,255,255,.4)}
.chart-area{position:relative;height:220rpx;margin-top:26rpx;border-radius:18rpx;background-color:#121712}
.chart-line{position:absolute;left:0;right:0;height:1rpx;background-color:rgba(255,255,255,.08)}
.chart-line-top{top:52rpx}.chart-line-mid{top:114rpx}
.chart-bars{position:absolute;left:30rpx;right:30rpx;bottom:22rpx;height:150rpx}
.bar{position:absolute;bottom:0;width:34rpx;border-radius:20rpx 20rpx 0 0;background-color:#10b981}
.bar-1{left:0;height:0}.bar-2{left:72rpx;height:0}.bar-3{left:144rpx;height:0}.bar-4{left:216rpx;height:0}.bar-5{left:288rpx;height:0}.bar-6{left:360rpx;height:0}.bar-7{left:432rpx;height:0}
.sleep-cards{overflow:hidden;margin-top:22rpx}
.sleep-card{position:relative;float:left;width:200rpx;min-height:118rpx;padding:18rpx 16rpx;border-radius:20rpx;background-color:#1c1f26}
.sleep-card-left{float:left}
.sleep-card-mid{margin-left:16rpx}
.sleep-card-right{float:right}
.sleep-top-line{position:absolute;left:0;top:0;width:100%;height:4rpx;border-radius:20rpx 20rpx 0 0}
.sleep-name{display:block;font-size:18rpx;color:rgba(255,255,255,.42)}
.sleep-value{display:block;margin-top:22rpx;font-size:34rpx;color:#ffffff}
.sleep-unit{font-size:18rpx;color:rgba(255,255,255,.34)}
.sleep-bar{overflow:hidden;height:14rpx;margin-top:22rpx;border-radius:14rpx;background-color:rgba(255,255,255,.06)}
.sleep-segment{float:left;height:14rpx}
.energy-card{overflow:hidden;margin-bottom:28rpx;padding:26rpx 26rpx;border-radius:28rpx;border:1rpx solid rgba(57,216,122,.22);background-color:#16201b}
.energy-icon{float:left;width:64rpx;height:64rpx;border-radius:32rpx;background-color:rgba(57,216,122,.14);line-height:64rpx;text-align:center;color:#39d87a;font-size:28rpx}
.energy-copy{float:left;margin-left:18rpx}
.energy-title{display:block;font-size:28rpx;color:#ffffff}
.energy-desc{display:block;margin-top:8rpx;font-size:20rpx;color:rgba(255,255,255,.42)}
.energy-value{float:right;margin-top:8rpx;font-size:40rpx;color:#ffffff}
.element-ring{width:240rpx;height:240rpx;margin:24rpx auto;border-radius:120rpx;border:18rpx solid rgba(57,216,122,.72);background-color:rgba(57,216,122,.08)}
.element-ring-core{width:146rpx;height:146rpx;margin:29rpx auto 0;border-radius:73rpx;background-color:#0d1110;text-align:center}
.ring-small{display:block;padding-top:34rpx;font-size:20rpx;color:rgba(255,255,255,.3)}
.ring-main{display:block;margin-top:8rpx;font-size:40rpx;color:#39d87a}
.element-list{padding:10rpx 16rpx;border-radius:20rpx;background-color:#1c1f26}
.element-row{overflow:hidden;padding:14rpx 0;border-bottom:1rpx solid rgba(255,255,255,.05)}
.element-row-last{border-bottom:0}
.element-left{float:left;max-width:310rpx}
.element-dot{float:left;width:12rpx;height:12rpx;margin-top:16rpx;border-radius:6rpx}
.element-copy{float:left;margin-left:12rpx}
.element-name{display:block;font-size:24rpx;color:#ffffff}
.element-jade{display:block;margin-top:6rpx;font-size:20rpx;color:rgba(255,255,255,.3)}
.element-suitable{float:right;max-width:300rpx;margin-top:2rpx;font-size:20rpx;line-height:48rpx;white-space:nowrap;text-align:right;color:rgba(255,255,255,.76)}
.bottom-space{height:30rpx}
.tabbar{position:fixed;left:18rpx;right:18rpx;bottom:16rpx;height:104rpx;padding-top:12rpx;border-radius:28rpx;background-color:rgba(18,18,20,.96);border:1rpx solid rgba(255,255,255,.08)}
.tab-item{float:left;width:238rpx;text-align:center;color:rgba(255,255,255,.55)}
.tab-item-active{color:#39d87a}
.tab-icon{display:block;font-size:34rpx;line-height:1.1}
.tab-text{display:block;margin-top:8rpx;font-size:18rpx}
.tab-text-muted{color:rgba(255,255,255,.4)}
