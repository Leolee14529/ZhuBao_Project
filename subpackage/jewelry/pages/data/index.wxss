.data-page{position:relative;width:100%;height:100vh;min-height:100vh;overflow:hidden;background:#121319;color:#fff}
.data-scroll{height:100vh;min-height:100%;background:#121319}
.page-body{min-height:100%;padding:0 24rpx calc(158rpx + constant(safe-area-inset-bottom));padding:0 24rpx calc(158rpx + env(safe-area-inset-bottom));background:#121319;box-sizing:border-box}
.page-top-spacer{width:100%}.page-header{margin-bottom:28rpx}.page-title{display:block;font-size:38rpx;font-weight:300;color:#fff}.page-subtitle{display:block;margin-top:10rpx;font-size:22rpx;letter-spacing:4rpx;color:#39d87a}
.score-card{display:flex;align-items:center;gap:24rpx;padding:32rpx 30rpx 30rpx;margin-bottom:28rpx;border:1rpx solid rgba(57,216,122,.22);border-radius:30rpx;background:#151d1a}
.score-copy{flex:1;min-width:0}.score-label-row{overflow:hidden}.score-dot{float:left;width:10rpx;height:10rpx;margin:9rpx 10rpx 0 0;border-radius:5rpx;background:#39d87a}.score-label{float:left;font-size:20rpx;letter-spacing:2rpx;color:rgba(57,216,122,.82)}
.score-value{display:block;margin-top:16rpx;font-size:54rpx;font-weight:300;color:#fff}.score-unit{font-size:26rpx;color:rgba(255,255,255,.42)}.score-text{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:rgba(255,255,255,.48)}.score-loading{font-size:32rpx}
.score-ring{flex:none;width:136rpx;height:136rpx;padding:12rpx;border:12rpx solid #10b981;border-radius:72rpx;background:rgba(16,185,129,.12);box-sizing:border-box}.score-ring-inner{width:88rpx;height:88rpx;border-radius:44rpx;background:#08100d;text-align:center;line-height:88rpx;color:#39d87a;font-size:38rpx}
.retry-button{flex:none;min-width:120rpx;margin:0;padding:0 24rpx;border:1rpx solid rgba(57,216,122,.5);border-radius:32rpx;background:rgba(57,216,122,.08);color:#39d87a;font-size:24rpx;line-height:64rpx}.retry-button::after{border:0}
.period-entry{display:flex;align-items:center;justify-content:center;position:relative;height:112rpx;margin-bottom:28rpx;border:1rpx solid rgba(57,216,122,.4);border-radius:28rpx;background:linear-gradient(180deg,rgba(16,29,23,.98),rgba(12,22,18,.98));box-shadow:0 0 0 1rpx rgba(57,216,122,.08) inset}.period-entry-title{font-size:28rpx;font-weight:500;letter-spacing:2rpx;color:#14e29a}.period-entry-arrow{position:absolute;right:34rpx;top:50%;transform:translateY(-50%);font-size:44rpx;line-height:1;color:#14e29a}
.health-card{display:flex;align-items:center;justify-content:space-between;min-height:210rpx;margin-bottom:28rpx;padding:28rpx 26rpx;border:1rpx solid rgba(255,255,255,.07);border-radius:28rpx;background:#171920;box-sizing:border-box}.health-card-hover{opacity:.78;transform:scale(.99)}.health-card-main{flex:1;min-width:0}.health-card-heading{display:flex;align-items:center;gap:14rpx}.health-icon{width:52rpx;height:52rpx;border-radius:26rpx;line-height:50rpx;text-align:center;font-size:34rpx;background:rgba(57,216,122,.12);color:#39d87a}.health-title{font-size:30rpx;color:#fff}.health-duration{display:block;margin-top:26rpx;font-size:38rpx;font-weight:500;color:rgba(255,255,255,.96)}.health-card-side{flex:none;margin-left:18rpx}.health-arrow{font-size:42rpx;line-height:1;color:#39d87a}
.panel{margin-bottom:28rpx;padding:28rpx;border:1rpx solid rgba(255,255,255,.06);border-radius:28rpx;background:#171920}.panel-title{display:block;font-size:30rpx;color:#fff}.panel-subtitle{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:rgba(255,255,255,.4)}
.record-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.record-item{display:flex;flex-direction:column;gap:10rpx;width:calc(50% - 8rpx);padding:20rpx;border-radius:18rpx;background:#121712;box-sizing:border-box}.record-item-wide{width:100%}.record-label{font-size:20rpx;color:rgba(255,255,255,.42)}.record-value{font-size:30rpx;color:#fff}
.tag-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.record-tag{padding:10rpx 18rpx;border-radius:22rpx;background:rgba(57,216,122,.1);color:#74e3ac;font-size:22rpx}.record-note{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid rgba(255,255,255,.07)}.record-note-text{display:block;margin-top:10rpx;color:rgba(255,255,255,.78);font-size:24rpx;line-height:1.6}.empty-panel{min-height:160rpx}.bottom-space{height:36rpx}
.record-actions{display:flex;gap:16rpx;margin-top:26rpx}.record-action,.create-record-button{margin:0;border-radius:20rpx;font-size:24rpx;line-height:68rpx}.record-action::after,.create-record-button::after,.undo-bar button::after{border:0}.record-action{flex:1}.record-action-primary,.create-record-button{background:rgba(57,216,122,.14);color:#74e3ac}.record-action-danger{background:rgba(255,102,102,.08);color:#f3a0a0}.create-record-button{margin-top:24rpx}.undo-bar{position:fixed;z-index:180;left:24rpx;right:24rpx;bottom:calc(126rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;padding:20rpx 24rpx;border:1rpx solid rgba(57,216,122,.28);border-radius:22rpx;background:#1a211e;color:#fff;font-size:24rpx}.undo-bar button{margin:0;padding:0;background:transparent;color:#39d87a;font-size:24rpx;line-height:48rpx}
.panel-heading-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.panel-range{flex:none;margin-top:4rpx;color:rgba(255,255,255,.34);font-size:20rpx;font-variant-numeric:tabular-nums}.weekly-loading,.weekly-empty,.feeling-empty{margin-top:24rpx;padding:30rpx 22rpx;border-radius:18rpx;background:#111713;color:rgba(255,255,255,.45);font-size:22rpx;line-height:1.6;text-align:center}.weekly-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:24rpx;padding:20rpx 22rpx;border-radius:18rpx;background:rgba(255,102,102,.07);color:#f3a0a0;font-size:22rpx}.weekly-retry-button{flex:none;margin:0;padding:0 20rpx;border:1rpx solid rgba(243,160,160,.26);border-radius:22rpx;background:transparent;color:#f3a0a0;font-size:22rpx;line-height:64rpx}.weekly-retry-button::after{border:0}
.rhythm-chart{display:flex;align-items:flex-end;justify-content:space-between;height:196rpx;margin-top:26rpx;padding:18rpx 12rpx 0;border-radius:20rpx;background:linear-gradient(180deg,rgba(8,20,14,.94),rgba(12,18,15,.72));box-sizing:border-box}.rhythm-day{display:flex;flex:1;flex-direction:column;align-items:center;min-width:0}.rhythm-track{display:flex;align-items:flex-end;justify-content:center;width:32rpx;height:112rpx;border-radius:16rpx;background:rgba(255,255,255,.035);overflow:hidden}.rhythm-bar{width:100%;border-radius:16rpx;background:rgba(255,255,255,.06)}.rhythm-bar-filled{background:linear-gradient(180deg,#49e49a,#138b60);box-shadow:0 0 18rpx rgba(57,216,122,.16)}.rhythm-value{margin-top:8rpx;color:rgba(255,255,255,.48);font-size:18rpx;font-variant-numeric:tabular-nums}.rhythm-label{margin-top:4rpx;color:rgba(255,255,255,.36);font-size:18rpx}.rhythm-day-today .rhythm-label,.rhythm-day-today .rhythm-value{color:#74e3ac}
.weekly-stats{display:flex;gap:12rpx;margin-top:18rpx}.weekly-stat{flex:1;min-width:0;padding:18rpx 14rpx;border-top:3rpx solid rgba(57,216,122,.72);border-radius:4rpx 4rpx 16rpx 16rpx;background:rgba(255,255,255,.025)}.weekly-stat-label,.weekly-stat-value{display:block}.weekly-stat-label{color:rgba(255,255,255,.42);font-size:19rpx;white-space:nowrap}.weekly-stat-value{margin-top:12rpx;color:#fff;font-size:28rpx;font-variant-numeric:tabular-nums}
.feeling-list{display:flex;gap:12rpx;margin-top:24rpx}.feeling-item{position:relative;display:flex;flex:1;flex-direction:column;min-width:0;padding:20rpx 18rpx;border-radius:18rpx;background:rgba(255,255,255,.025);overflow:hidden}.feeling-accent{position:absolute;left:0;right:0;top:0;height:3rpx;background:linear-gradient(90deg,#12c889,#73e7b1)}.feeling-name{color:rgba(255,255,255,.52);font-size:21rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.feeling-count{margin-top:16rpx;color:#fff;font-size:30rpx;font-variant-numeric:tabular-nums}
.today-feeling-card{display:flex;align-items:flex-start;gap:18rpx;margin-bottom:28rpx;padding:26rpx;border:1rpx solid rgba(57,216,122,.16);border-radius:28rpx;background:linear-gradient(135deg,#152019,#121a16);box-sizing:border-box}.today-feeling-card-ready{border-color:rgba(57,216,122,.32)}.feeling-mark{display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;border-radius:28rpx;background:rgba(57,216,122,.13)}.feeling-mark-core{width:16rpx;height:16rpx;border:3rpx solid #48df95;transform:rotate(45deg);box-sizing:border-box}.today-feeling-copy{flex:1;min-width:0}.today-feeling-title{display:block;color:#fff;font-size:27rpx}.today-feeling-text{display:block;margin-top:10rpx;color:rgba(255,255,255,.7);font-size:22rpx;line-height:1.55}.today-feeling-detail{display:block;margin-top:8rpx;color:rgba(116,227,172,.62);font-size:19rpx;line-height:1.5}.today-feeling-status{flex:none;margin-top:6rpx;color:rgba(255,255,255,.58);font-size:21rpx}
.sleep-trend-more{flex:none;margin:0;padding:0;background:transparent;color:#64d99d;font-size:21rpx;line-height:44rpx}.sleep-trend-more::after{border:0}.sleep-trend-chart{display:flex;align-items:flex-end;height:180rpx;margin-top:24rpx;padding:18rpx 14rpx 0;border:1rpx solid rgba(57,216,122,.08);border-radius:20rpx;background:linear-gradient(180deg,rgba(8,23,15,.86),rgba(13,18,15,.5));box-sizing:border-box}.sleep-trend-day{display:flex;flex:1;flex-direction:column;align-items:center}.sleep-trend-track{display:flex;align-items:flex-end;width:28rpx;height:118rpx;border-radius:14rpx;background:rgba(255,255,255,.035);overflow:hidden}.sleep-trend-bar{width:100%;border-radius:14rpx;background:linear-gradient(180deg,#70e7ad,#189664);box-shadow:0 0 16rpx rgba(57,216,122,.14)}.sleep-trend-label{margin-top:8rpx;color:rgba(255,255,255,.34);font-size:18rpx}.sleep-trend-day-today .sleep-trend-label{color:#74e3ac}.sleep-trend-stats{display:flex;gap:14rpx;margin-top:18rpx}.sleep-trend-stat{flex:1;padding:18rpx 20rpx;border-radius:18rpx;background:rgba(255,255,255,.025)}.sleep-trend-stat text{display:block;color:rgba(255,255,255,.4);font-size:20rpx}.sleep-trend-stat .sleep-trend-value{margin-top:10rpx;color:#fff;font-size:28rpx;font-weight:500;font-variant-numeric:tabular-nums}
