<view class="data-page">
  <scroll-view class="data-scroll" scroll-y="true">
    <view class="page-body">
      <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>
      <view class="page-header">
        <text class="page-title">{{copy.title}}</text>
        <text class="page-subtitle">{{copy.subtitle}}</text>
      </view>

      <view class="score-card">
        <view class="score-copy">
          <view class="score-label-row"><view class="score-dot"></view><text class="score-label">{{copy.score}}</text></view>
          <text class="score-value" wx:if="{{!loading}}">{{record.entryCount}} <text class="score-unit">{{copy.entriesUnit}}</text></text>
          <text class="score-value score-loading" wx:else>{{copy.loading}}</text>
          <text class="score-text" wx:if="{{loadError}}">{{loadError}}</text>
          <text class="score-text" wx:elif="{{record.hasRecord}}">{{copy.recorded}}</text>
          <text class="score-text" wx:else>{{copy.noRecord}}</text>
        </view>
        <button class="retry-button" wx:if="{{loadError}}" bindtap="retryLoad">{{copy.retry}}</button>
        <view class="score-ring" wx:else><view class="score-ring-inner"><text>✓</text></view></view>
      </view>

      <view class="period-entry" bindtap="openPeriodCalendar">
        <text class="period-entry-title">{{copy.calendar}}</text><text class="period-entry-arrow">›</text>
      </view>

      <view class="health-card sleep-entry" hover-class="health-card-hover" bindtap="openSleepDetail">
        <view class="health-card-main">
          <view class="health-card-heading"><view class="health-icon sleep-icon">☾</view><text class="health-title">{{copy.sleep}}</text></view>
          <text class="health-duration">{{record.sleep}}</text>
          <text class="panel-subtitle">{{copy.sleepSource}}</text>
        </view>
        <view class="health-card-side"><text class="health-arrow">›</text></view>
      </view>

      <view class="panel" wx:if="{{canEdit && record.hasRecord}}">
        <text class="panel-title">{{copy.recordDetails}}</text>
        <view class="record-grid">
          <view class="record-item"><text class="record-label">{{copy.moodScore}}</text><text class="record-value">{{record.mood}}</text></view>
          <view class="record-item"><text class="record-label">{{copy.energyScore}}</text><text class="record-value">{{record.energy}}</text></view>
          <view class="record-item record-item-wide"><text class="record-label">{{copy.wearing}}</text><text class="record-value">{{record.wearing}}</text></view>
        </view>
        <view class="tag-list" wx:if="{{record.tags.length}}"><text class="record-tag" wx:for="{{record.tags}}" wx:key="*this">{{item}}</text></view>
        <view class="record-note"><text class="record-label">{{copy.note}}</text><text class="record-note-text">{{record.note}}</text></view>
        <view class="record-actions"><button class="record-action record-action-primary" bindtap="openEditor">{{copy.editRecord}}</button><button class="record-action record-action-danger" bindtap="deleteRecord">{{copy.deleteRecord}}</button></view>
      </view>

      <view class="panel empty-panel" wx:if="{{showEmpty}}">
        <text class="panel-title">{{copy.emptyTitle}}</text>
        <text class="panel-subtitle">{{copy.emptyDesc}}</text>
        <button class="create-record-button" bindtap="openEditor">{{copy.createRecord}}</button>
      </view>

      <view class="panel weekly-rhythm-panel">
        <view class="panel-heading-row">
          <view><text class="panel-title">{{copy.weekRhythm}}</text><text class="panel-subtitle">{{copy.weekRhythmSubtitle}}</text></view>
          <text class="panel-range">{{weekly.days[0].dateLabel}}—{{weekly.days[6].dateLabel}}</text>
        </view>
        <view class="weekly-loading" wx:if="{{weeklyLoading}}">{{copy.loading}}</view>
        <view class="weekly-error" wx:elif="{{weeklyError}}"><text>{{weeklyError}}</text><button class="weekly-retry-button" bindtap="retryWeekly">{{copy.retry}}</button></view>
        <block wx:else>
          <view class="rhythm-chart" wx:if="{{weekly.hasRecords}}" aria-label="{{copy.weekRhythm}}">
            <view class="rhythm-day {{item.isToday ? 'rhythm-day-today' : ''}}" wx:for="{{weekly.days}}" wx:key="dateKey">
              <view class="rhythm-track"><view class="rhythm-bar {{item.value ? 'rhythm-bar-filled' : ''}}" style="height: {{item.barHeight}}rpx;"></view></view>
              <text class="rhythm-value">{{item.value || '·'}}</text>
              <text class="rhythm-label">{{item.dayLabel}}</text>
            </view>
          </view>
          <view class="weekly-empty" wx:else>{{weekly.summary}}</view>
          <view class="weekly-stats">
            <view class="weekly-stat"><text class="weekly-stat-label">{{copy.weekRecorded}}</text><text class="weekly-stat-value">{{weekly.recordedDays}}</text></view>
            <view class="weekly-stat"><text class="weekly-stat-label">{{copy.averageMood}}</text><text class="weekly-stat-value">{{weekly.averageMood}}</text></view>
            <view class="weekly-stat"><text class="weekly-stat-label">{{copy.jewelryDays}}</text><text class="weekly-stat-value">{{weekly.jewelryDays}}</text></view>
          </view>
        </block>
      </view>

      <view class="panel feeling-summary-panel">
        <text class="panel-title">{{copy.feelings}}</text>
        <text class="panel-subtitle">{{copy.feelingsSubtitle}}</text>
        <view class="feeling-list" wx:if="{{weekly.topFeelings.length}}">
          <view class="feeling-item" wx:for="{{weekly.topFeelings}}" wx:key="label"><view class="feeling-accent"></view><text class="feeling-name">{{item.label}}</text><text class="feeling-count">{{item.countText}}</text></view>
        </view>
        <view class="feeling-empty" wx:else>{{copy.noFeelings}}</view>
      </view>

      <view class="today-feeling-card {{todayFeeling.hasRecord ? 'today-feeling-card-ready' : ''}}">
        <view class="feeling-mark"><view class="feeling-mark-core"></view></view>
        <view class="today-feeling-copy"><text class="today-feeling-title">{{copy.todayFeeling}}</text><text class="today-feeling-text">{{todayFeeling.title}}</text><text class="today-feeling-detail" wx:if="{{todayFeeling.detail}}">{{todayFeeling.detail}}</text></view>
        <text class="today-feeling-status">{{todayFeeling.hasRecord ? copy.feelingReady : copy.feelingPending}}</text>
      </view>

      <view class="panel sleep-trend-panel">
        <view class="panel-heading-row">
          <view><text class="panel-title">{{copy.sleepTrend}}</text><text class="panel-subtitle">{{copy.sleepTrendSubtitle}}</text></view>
          <button class="sleep-trend-more" bindtap="openSleepDetail">{{copy.viewSleepTrend}} ›</button>
        </view>
        <view class="weekly-loading" wx:if="{{weeklyLoading}}">{{copy.loading}}</view>
        <view class="weekly-error" wx:elif="{{weeklyError}}"><text>{{weeklyError}}</text><button class="weekly-retry-button" bindtap="retryWeekly">{{copy.retry}}</button></view>
        <block wx:else>
          <view class="sleep-trend-chart" wx:if="{{sleepTrend.hasRecords}}">
            <view class="sleep-trend-day {{item.isEnd ? 'sleep-trend-day-today' : ''}}" wx:for="{{sleepTrend.points}}" wx:key="dateKey">
              <view class="sleep-trend-track"><view class="sleep-trend-bar" style="height: {{item.barHeight}}rpx;"></view></view>
              <text class="sleep-trend-label">{{item.label}}</text>
            </view>
          </view>
          <view class="weekly-empty" wx:else>{{sleepTrend.summary}}</view>
          <view class="sleep-trend-stats">
            <view class="sleep-trend-stat"><text>{{copy.averageSleep}}</text><text class="sleep-trend-value">{{sleepTrend.averageSleep}}</text></view>
            <view class="sleep-trend-stat"><text>{{copy.recordedNights}}</text><text class="sleep-trend-value">{{sleepTrend.recordedNights}}</text></view>
          </view>
        </block>
      </view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
  <view class="undo-bar" wx:if="{{undoView.visible}}"><text>{{copy.deleted}}</text><button loading="{{undoView.restoring}}" disabled="{{!undoView.canRetry}}" bindtap="undoDelete">{{copy.undo}}</button></view>
  <daily-record-editor visible="{{editorVisible}}" value="{{editorValue}}" date-key="{{dateKey}}" copy="{{copy}}" saving="{{saving}}" bind:close="closeEditor" bind:save="saveRecord" bind:invalid="handleEditorInvalid"></daily-record-editor>
  <bottom-nav active="data"></bottom-nav>
</view>
