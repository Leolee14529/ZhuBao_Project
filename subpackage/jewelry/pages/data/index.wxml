<view class="data-page">
  <scroll-view class="data-scroll" scroll-y="true">
    <view class="page-body">
      <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>
      <view class="page-header">
        <text class="page-title">{{copy.title}}</text>
        <text class="page-subtitle">{{copy.subtitle}}</text>
      </view>

      <view class="score-card">
        <view class="score-copy">
          <view class="score-label-row"><view class="score-dot"></view><text class="score-label">{{copy.score}}</text></view>
          <text class="score-value" wx:if="{{!loading}}">{{record.entryCount}} <text class="score-unit">{{copy.entriesUnit}}</text></text>
          <text class="score-value score-loading" wx:else>{{copy.loading}}</text>
          <text class="score-text" wx:if="{{loadError}}">{{loadError}}</text>
          <text class="score-text" wx:elif="{{record.hasRecord}}">{{copy.recorded}}</text>
          <text class="score-text" wx:else>{{copy.noRecord}}</text>
        </view>
        <button class="retry-button" wx:if="{{loadError}}" bindtap="retryLoad">{{copy.retry}}</button>
        <view class="score-ring" wx:else><view class="score-ring-inner"><text>✓</text></view></view>
      </view>

      <view class="period-entry" bindtap="openPeriodCalendar">
        <text class="period-entry-title">{{copy.calendar}}</text><text class="period-entry-arrow">›</text>
      </view>

      <view class="health-card sleep-entry" hover-class="health-card-hover" bindtap="openSleepDetail">
        <view class="health-card-main">
          <view class="health-card-heading"><view class="health-icon sleep-icon">☾</view><text class="health-title">{{copy.sleep}}</text></view>
          <text class="health-duration">{{record.sleep}}</text>
          <text class="panel-subtitle">{{copy.sleepSource}}</text>
        </view>
        <view class="health-card-side"><text class="health-arrow">›</text></view>
      </view>

      <view class="panel" wx:if="{{canEdit && record.hasRecord}}">
        <text class="panel-title">{{copy.recordDetails}}</text>
        <view class="record-grid">
          <view class="record-item"><text class="record-label">{{copy.moodScore}}</text><text class="record-value">{{record.mood}}</text></view>
          <view class="record-item"><text class="record-label">{{copy.energyScore}}</text><text class="record-value">{{record.energy}}</text></view>
          <view class="record-item record-item-wide"><text class="record-label">{{copy.wearing}}</text><text class="record-value">{{record.wearing}}</text></view>
        </view>
        <view class="tag-list" wx:if="{{record.tags.length}}"><text class="record-tag" wx:for="{{record.tags}}" wx:key="*this">{{item}}</text></view>
        <view class="record-note"><text class="record-label">{{copy.note}}</text><text class="record-note-text">{{record.note}}</text></view>
        <view class="record-actions"><button class="record-action record-action-primary" bindtap="openEditor">{{copy.editRecord}}</button><button class="record-action record-action-danger" bindtap="deleteRecord">{{copy.deleteRecord}}</button></view>
      </view>

      <view class="panel empty-panel" wx:if="{{showEmpty}}">
        <text class="panel-title">{{copy.emptyTitle}}</text>
        <text class="panel-subtitle">{{copy.emptyDesc}}</text>
        <button class="create-record-button" bindtap="openEditor">{{copy.createRecord}}</button>
      </view>
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
  <view class="undo-bar" wx:if="{{undoView.visible}}"><text>{{copy.deleted}}</text><button loading="{{undoView.restoring}}" disabled="{{!undoView.canRetry}}" bindtap="undoDelete">{{copy.undo}}</button></view>
  <daily-record-editor visible="{{editorVisible}}" value="{{editorValue}}" date-key="{{dateKey}}" copy="{{copy}}" saving="{{saving}}" bind:close="closeEditor" bind:save="saveRecord" bind:invalid="handleEditorInvalid"></daily-record-editor>
  <bottom-nav active="data"></bottom-nav>
</view>
