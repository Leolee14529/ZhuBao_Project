<view class="data-page">
  <scroll-view class="data-scroll" scroll-y="true">
    <view class="page-body">
      <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>
      <view class="page-header">
        <text class="page-title">Records</text>
        <text class="page-subtitle">Today's Summary</text>
      </view>

      <view class="score-card">
        <view class="score-copy">
          <view class="score-label-row">
            <view class="score-dot"></view>
            <text class="score-label">Today's Summary</text>
          </view>
          <text class="score-value">0 <text class="score-unit">items</text></text>
          <text class="score-text">No data recorded yet.</text>
        </view>
        <view class="score-ring">
          <view class="score-ring-inner">
            <text>→</text>
          </view>
        </view>
      </view>

      <view class="period-entry" bindtap="openPeriodCalendar">
        <text class="period-entry-title">Smart Period Calendar</text>
        <text class="period-entry-arrow">›</text>
      </view>

      <view class="health-entry-stack">
        <view class="health-card sleep-entry" hover-class="health-card-hover" bindtap="openSleepDetail">
          <view class="health-card-main">
            <view class="health-card-heading">
              <view class="health-icon sleep-icon">☾</view>
              <text class="health-title">Sleep</text>
            </view>
            <text class="health-duration">-- h -- min</text>
            <view class="health-meta-row">
              <view class="health-meta"><text class="health-meta-label">Asleep</text><text class="health-meta-value">--</text></view>
              <view class="health-meta"><text class="health-meta-label">Awake</text><text class="health-meta-value">--</text></view>
              <view class="health-meta"><text class="health-meta-label">Score</text><text class="health-meta-value">--</text></view>
            </view>
          </view>
          <view class="health-card-side">
            <view class="health-ring"><text>--</text></view>
            <text class="health-arrow">›</text>
          </view>
        </view>

        <view class="health-card activity-entry" hover-class="health-card-hover">
          <view class="health-card-main">
            <view class="health-card-heading">
              <view class="health-icon activity-icon">↗</view>
              <text class="health-title">Today's Activity</text>
            </view>
            <view class="activity-meta-grid">
              <view class="activity-meta"><text class="health-meta-label">Steps</text><text class="activity-value">{{activity.steps}}<text class="activity-unit"> steps</text></text></view>
              <view class="activity-meta"><text class="health-meta-label">Distance</text><text class="activity-value">{{activity.distance}}<text class="activity-unit"> km</text></text></view>
              <view class="activity-meta"><text class="health-meta-label">Calories</text><text class="activity-value">{{activity.calories}}<text class="activity-unit"> kcal</text></text></view>
            </view>
          </view>
          <view class="health-card-side">
            <view class="activity-ring"><view class="activity-ring-core">{{activity.progress}}</view></view>
            <text class="health-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="panel">
        <text class="panel-title">Rhythm Records</text>
        <text class="panel-subtitle">Today's SummaryReference</text>
        <view class="chart-area">
          <view class="chart-line chart-line-top"></view>
          <view class="chart-line chart-line-mid"></view>
          <view class="chart-bars">
            <view class="bar bar-1"></view>
            <view class="bar bar-2"></view>
            <view class="bar bar-3"></view>
            <view class="bar bar-4"></view>
            <view class="bar bar-5"></view>
            <view class="bar bar-6"></view>
            <view class="bar bar-7"></view>
          </view>
        </view>
      </view>

      <view class="panel">
        <text class="panel-title">Feeling Records</text>
        <text class="panel-subtitle">No records</text>
        <view class="sleep-cards">
          <block wx:for="{{sleep}}" wx:key="name">
            <view class="sleep-card {{item.cardClass}}">
              <view class="sleep-top-line" style="background-color: {{item.color}};"></view>
              <text class="sleep-name">{{item.name}}</text>
              <text class="sleep-value">{{item.value}}<text class="sleep-unit">x</text></text>
            </view>
          </block>
        </view>
        <view class="sleep-bar">
          <block wx:for="{{sleep}}" wx:key="name">
            <view class="sleep-segment" style="width: {{item.width}}; background-color: {{item.color}};"></view>
          </block>
        </view>
      </view>

      <view class="energy-card">
        <view class="energy-icon">✦</view>
        <view class="energy-copy">
          <text class="energy-title">Today's Feeling</text>
          <text class="energy-desc">No feeling records</text>
        </view>
        <text class="energy-value">None</text>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <bottom-nav active="data"></bottom-nav>
</view>
