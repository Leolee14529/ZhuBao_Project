.product-detail-page{height:100vh;min-height:100vh;overflow:hidden;background:radial-gradient(circle at 18% 0%,rgba(57,216,122,.13),transparent 36%),linear-gradient(180deg,#06100b 0%,#050806 44%,#030504 100%);color:#fff}.detail-scroll{height:100%}.detail-body{min-height:100%;padding:0 32rpx;box-sizing:border-box}.page-top-spacer{width:100%}
.detail-topbar{display:flex;align-items:center;gap:20rpx;min-height:88rpx;margin:24rpx 0 26rpx}.icon-button{position:relative;flex:0 0 80rpx;width:80rpx;height:80rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:40rpx;background:rgba(255,255,255,.055)}.icon-button::after{border:0}.back-chevron{position:absolute;left:31rpx;top:27rpx;width:20rpx;height:20rpx;border-left:3rpx solid rgba(255,255,255,.92);border-bottom:3rpx solid rgba(255,255,255,.92);transform:rotate(45deg)}.title-block{flex:1;min-width:0}.page-title,.page-subtitle{display:block}.page-title{font-size:40rpx;font-weight:600;line-height:1.15}.page-subtitle{margin-top:8rpx;color:rgba(255,255,255,.5);font-size:23rpx;line-height:1.4}
.hero-image-wrap{position:relative;width:100%;height:560rpx;max-height:56vh;overflow:hidden;border:1rpx solid rgba(255,255,255,.08);border-radius:30rpx;background:#0b0f0d;box-sizing:border-box}.hero-swiper,.hero-image,.hero-placeholder{display:block;width:100%;height:100%}.hero-placeholder{background:linear-gradient(135deg,#101713,#090d0b)}.hero-badge{position:absolute;left:22rpx;top:22rpx;padding:8rpx 18rpx;border-radius:999rpx;background:#39d87a;color:#04160c;font-size:22rpx;line-height:1.2}.image-counter{position:absolute;left:18rpx;bottom:18rpx;min-width:72rpx;min-height:54rpx;padding:0 16rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:999rpx;background:rgba(3,8,6,.76);color:rgba(255,255,255,.88);font-size:22rpx;line-height:54rpx;text-align:center;box-sizing:border-box;pointer-events:none}.preview-hint{position:absolute;right:18rpx;bottom:18rpx;display:flex;align-items:center;gap:10rpx;min-height:54rpx;padding:0 18rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:999rpx;background:rgba(3,8,6,.76);color:rgba(255,255,255,.86);font-size:22rpx;line-height:1.3;pointer-events:none}.preview-icon{position:relative;width:22rpx;height:22rpx;border:2rpx solid currentColor;border-radius:50%;box-sizing:border-box}.preview-icon::after{position:absolute;right:-7rpx;bottom:-5rpx;width:9rpx;height:2rpx;border-radius:2rpx;background:currentColor;content:"";transform:rotate(45deg);transform-origin:left center}.hero-image-pressed{opacity:.88}
.detail-panel,.mood-panel,.color-panel,.style-panel{margin-top:24rpx;padding:28rpx;border:1rpx solid rgba(255,255,255,.08);border-radius:28rpx;background:rgba(11,14,13,.96)}.mood-panel{border-color:rgba(57,216,122,.22);background:linear-gradient(145deg,rgba(12,37,26,.98),rgba(7,13,10,.98))}.detail-kicker,.detail-title,.detail-desc,.detail-long,.section-title,.style-text,.mood-reference-desc{display:block}.detail-kicker{color:rgba(70,222,155,.84);font-size:22rpx;line-height:1.5}.detail-title{margin-top:12rpx;color:#fff;font-size:42rpx;font-weight:600;line-height:1.24}.detail-desc,.detail-long,.style-text{margin-top:18rpx;color:rgba(255,255,255,.74);font-size:26rpx;line-height:1.72;word-break:break-word}.detail-long{color:rgba(255,255,255,.58)}.section-title{color:#fff;font-size:30rpx;font-weight:600;line-height:1.35}.mood-reference-desc{margin-top:16rpx;color:rgba(255,255,255,.58);font-size:24rpx;line-height:1.65;word-break:break-word}.mood-chip-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:22rpx}.mood-chip{min-height:56rpx;padding:0 20rpx;border:1rpx solid rgba(83,229,164,.25);border-radius:999rpx;background:rgba(57,216,122,.1);color:#69e3a9;font-size:23rpx;line-height:56rpx}.mood-palette-strip{display:flex;gap:0;margin-top:22rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.12);border-radius:14rpx}.mood-color{flex:1;height:20rpx}
.palette-list{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx}.palette-item{display:flex;align-items:center;gap:10rpx;min-height:58rpx;padding:0 18rpx 0 12rpx;border-radius:999rpx;background:rgba(255,255,255,.06);color:rgba(255,255,255,.78)}.palette-swatch{width:30rpx;height:30rpx;border:1rpx solid rgba(255,255,255,.34);border-radius:50%}.palette-label{font-size:24rpx;line-height:1.4}.record-button{display:flex;align-items:center;gap:20rpx;width:100%;min-height:112rpx;margin-top:24rpx;padding:20rpx 24rpx 20rpx 28rpx;border:1rpx solid rgba(83,229,164,.42);border-radius:28rpx;background:linear-gradient(135deg,rgba(36,151,91,.34),rgba(9,35,23,.98));color:#fff;text-align:left;box-sizing:border-box}.record-button::after{border:0}.record-button-copy{flex:1;min-width:0}.record-button-title,.record-button-hint{display:block;word-break:break-word}.record-button-title{color:#77ebb6;font-size:28rpx;font-weight:600;line-height:1.35}.record-button-hint{margin-top:7rpx;color:rgba(255,255,255,.54);font-size:21rpx;line-height:1.45}.record-button-arrow{flex-shrink:0;color:#74e9b2;font-size:46rpx;font-weight:300;line-height:1}.safe-bottom-space{height:calc(82rpx + env(safe-area-inset-bottom))}
