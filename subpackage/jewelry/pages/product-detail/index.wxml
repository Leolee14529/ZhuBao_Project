<view class="product-detail-page">
  <view
    class="page-back-button"
    style="top: {{backButtonTop}}px;"
    bindtap="handleBack"
  >
    <view class="page-back-chevron"></view>
  </view>
  <scroll-view class="detail-scroll" scroll-y="true" enhanced="true" bounces="true" show-scrollbar="false">
    <view class="detail-body">
      <view class="page-top-spacer" style="height: {{topSpacer}}px;"></view>

      <view class="detail-topbar">
        <view class="topbar-leading"></view>
        <view class="title-block">
          <text class="page-title">Style Detail</text>
          <text class="page-subtitle">Full Style Reference</text>
        </view>
      </view>

      <view class="hero-image-wrap">
        <image wx:if="{{product}}" class="hero-image" src="{{product.image}}" mode="aspectFit" fade-in="{{false}}"></image>
        <view wx:else class="hero-placeholder"></view>
        <text wx:if="{{product && product.tag}}" class="hero-badge">{{product.tag}}</text>
      </view>

      <block wx:if="{{product}}">
        <view class="detail-panel">
          <text class="detail-kicker">{{product.type}}</text>
          <text class="detail-title">{{product.name}}</text>
          <text class="detail-desc">{{product.desc}}</text>
          <text class="detail-long">{{product.detail}}</text>
        </view>

        <view class="color-panel">
          <text class="section-title">Color and Material</text>
          <view class="palette-list">
            <block wx:for="{{palette}}" wx:key="label">
              <view class="palette-item">
                <view class="palette-swatch" style="background-color: {{item.color}};"></view>
                <text class="palette-label">{{item.label}}</text>
              </view>
            </block>
          </view>
        </view>

        <view class="style-panel">
          <text class="section-title">Styling Ideas</text>
          <text class="style-text">{{product.scene}}</text>
        </view>
      </block>
      <view wx:else class="detail-loading-panel">
        <view class="loading-line loading-line-short"></view>
        <view class="loading-line loading-line-title"></view>
        <view class="loading-line"></view>
        <view class="loading-line loading-line-wide"></view>
      </view>

      <view class="safe-bottom-space"></view>
    </view>
  </scroll-view>
</view>
