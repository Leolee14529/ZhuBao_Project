.sleep-form-value-card{display:flex;align-items:center;min-height:88rpx;padding:0 24rpx;border-radius:24rpx;background:#21242d}
.sleep-form-value{font-size:28rpx;color:rgba(255,255,255,.92)}
.sleep-duration-row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}
.sleep-duration-input{width:140rpx;height:88rpx;padding:0 24rpx;border-radius:24rpx;background:#21242d;color:#fff;font-size:30rpx;box-sizing:border-box}
