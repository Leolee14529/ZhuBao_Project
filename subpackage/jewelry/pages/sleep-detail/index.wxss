.sleep-page,.sleep-scroll{height:100vh;background:#121319;color:#fff}.sleep-body{padding:0 24rpx 48rpx}.sleep-topbar{position:relative;height:88rpx;display:flex;align-items:center;justify-content:center}.topbar-title{font-size:34rpx}.topbar-button{position:absolute;left:-12rpx;background:transparent;color:#fff;font-size:60rpx}.topbar-button::after{border:0}.date-value{display:block;margin:18rpx 0;text-align:center;font-size:26rpx;color:rgba(255,255,255,.8)}.detail-card{margin-bottom:18rpx;padding:26rpx;border-radius:28rpx;background:#171920;border:1rpx solid rgba(255,255,255,.07)}.detail-card-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.detail-card-title{font-size:28rpx}.detail-card-caption{font-size:20rpx;color:rgba(255,255,255,.4)}.sleep-total{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-top:34rpx}.sleep-total-label{font-size:22rpx;color:rgba(255,255,255,.42)}.sleep-total-value{font-size:42rpx;font-weight:500;color:#39d87a}.load-error{display:block;margin-top:24rpx;font-size:22rpx;line-height:1.6;color:#f3b7b7}.retry-button{margin:20rpx 0 0;padding:0 28rpx;border:1rpx solid rgba(57,216,122,.5);border-radius:30rpx;background:rgba(57,216,122,.08);color:#39d87a;font-size:24rpx;line-height:60rpx}.retry-button::after{border:0}.honest-empty-card{min-height:220rpx}.empty-title{display:block;margin-top:34rpx;font-size:30rpx;color:#fff}.empty-description{display:block;margin-top:14rpx;font-size:22rpx;line-height:1.7;color:rgba(255,255,255,.46)}
