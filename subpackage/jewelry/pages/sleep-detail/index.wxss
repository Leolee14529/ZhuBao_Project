.sleep-page{width:100%;height:100vh;background:#121319;color:#fff;overflow:hidden}.sleep-scroll{height:100vh}.sleep-body{padding:0 24rpx calc(44rpx + env(safe-area-inset-bottom));box-sizing:border-box}.sleep-page-back{position:fixed!important;left:0!important;width:88rpx;height:88rpx;margin:0!important;padding:0!important;background:transparent!important;transform:none!important;display:flex;align-items:center;justify-content:center;box-sizing:border-box;z-index:1000}.page-back-chevron{width:20rpx;height:20rpx;border-left:4rpx solid #ffffff;border-bottom:4rpx solid #ffffff;transform:rotate(45deg);box-sizing:border-box}.sleep-top-spacer{width:100%}.sleep-topbar{position:relative;height:88rpx;display:flex;align-items:center;justify-content:center}.topbar-title{font-size:34rpx;font-weight:500}.calendar-icon{position:absolute;right:8rpx;width:34rpx;height:30rpx;border:2rpx solid #39d87a;border-radius:6rpx}.calendar-icon::before{content:"";position:absolute;left:5rpx;right:5rpx;top:8rpx;border-top:2rpx solid #39d87a}.calendar-icon::after{content:"";position:absolute;left:7rpx;top:-7rpx;width:4rpx;height:10rpx;border-radius:4rpx;background:#39d87a;box-shadow:14rpx 0 #39d87a}.sleep-tabs{display:flex;margin:16rpx 0 20rpx;padding:6rpx;border-radius:18rpx;background:#171920}.sleep-tab{flex:1;padding:14rpx 0;border-radius:14rpx;text-align:center;font-size:24rpx;color:rgba(255,255,255,.42)}.sleep-tab-active{background:#193127;color:#39d87a}.date-switcher{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx;padding:0 16rpx}.date-arrow{width:56rpx;height:56rpx;text-align:center;font-size:44rpx;line-height:48rpx;color:#39d87a}.date-value{font-size:26rpx;color:rgba(255,255,255,.8)}.detail-card{margin-bottom:18rpx;padding:26rpx;border-radius:28rpx;background:#171920;border:1rpx solid rgba(255,255,255,.07)}.detail-card-heading{display:flex;align-items:center;justify-content:space-between}.detail-card-title{font-size:28rpx;color:#fff}.detail-card-caption{font-size:20rpx;color:rgba(255,255,255,.38)}.overview-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22rpx 18rpx;margin-top:24rpx}.overview-item{min-width:0}.overview-label,.quality-label{display:block;font-size:20rpx;color:rgba(255,255,255,.4)}.overview-value{display:block;margin-top:8rpx;font-size:28rpx;color:#fff}.overview-accent{color:#39d87a}.ratio-content{display:flex;align-items:center;gap:32rpx;margin-top:24rpx}.ratio-ring{display:flex;align-items:center;justify-content:center;flex:none;width:190rpx;height:190rpx;border-radius:95rpx;border:18rpx solid #39d87a;border-right-color:#1fae70;border-bottom-color:#69736f;background:#111613}.ratio-ring-core{display:flex;align-items:center;justify-content:center;width:116rpx;height:116rpx;border-radius:58rpx;background:#121319;font-size:22rpx;color:rgba(255,255,255,.5)}.stage-list{flex:1;min-width:0}.stage-row{display:flex;align-items:center;margin:15rpx 0}.stage-dot{flex:none;width:12rpx;height:12rpx;border-radius:6rpx}.stage-name{flex:1;margin-left:12rpx;font-size:22rpx;color:rgba(255,255,255,.7)}.stage-value{font-size:20rpx;color:rgba(255,255,255,.52)}.quality-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24rpx 18rpx;margin-top:24rpx}.quality-value{display:block;margin-top:8rpx;font-size:28rpx;color:#39d87a}.timeline{display:flex;overflow:hidden;height:44rpx;margin-top:28rpx;border-radius:22rpx;background:#101211}.timeline-segment{height:44rpx;min-width:2rpx}.timeline-labels{display:flex;justify-content:space-between;margin-top:10rpx;font-size:20rpx;color:rgba(255,255,255,.36)}.timeline-legend{display:flex;flex-wrap:wrap;gap:14rpx 22rpx;margin-top:24rpx}.legend-item{display:flex;align-items:center;gap:8rpx;font-size:20rpx;color:rgba(255,255,255,.56)}.detail-bottom-space{height:24rpx}
