.sleep-page,.sleep-scroll{height:100vh;background:#121319;color:#fff}.sleep-body{padding:0 24rpx 48rpx}.sleep-topbar{position:relative;height:88rpx;display:flex;align-items:center;justify-content:center}.topbar-title{font-size:34rpx}.topbar-button{position:absolute;left:-12rpx;background:transparent;color:#fff;font-size:60rpx}.topbar-button::after{border:0}.sleep-range-tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:22rpx;background:#171920}.range-tab{flex:1;margin:0;padding:0;border-radius:17rpx;background:transparent;color:rgba(255,255,255,.42);font-size:22rpx;line-height:64rpx}.range-tab::after{border:0}.range-tab-active{background:linear-gradient(135deg,rgba(36,154,96,.48),rgba(24,111,72,.34));color:#8ce6b8}.range-switcher{display:flex;align-items:center;justify-content:space-between;margin:10rpx 0}.range-switcher button{margin:0;padding:0 20rpx;background:transparent;color:#50d58f;font-size:48rpx;line-height:64rpx}.range-switcher button::after{border:0}.range-switcher .range-next-disabled{color:rgba(255,255,255,.18)}.date-value{display:block;margin:18rpx 0;text-align:center;font-size:24rpx;color:rgba(255,255,255,.72)}.detail-card{margin-bottom:18rpx;padding:26rpx;border-radius:28rpx;background:#171920;border:1rpx solid rgba(255,255,255,.07)}.detail-card-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.detail-card-title{font-size:28rpx}.detail-card-caption{font-size:20rpx;color:rgba(255,255,255,.4)}.sleep-total{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-top:34rpx}.sleep-total-label{font-size:22rpx;color:rgba(255,255,255,.42)}.sleep-total-value{font-size:42rpx;font-weight:500;color:#39d87a}.load-error{display:block;margin-top:24rpx;font-size:22rpx;line-height:1.6;color:#f3b7b7}.retry-button{margin:20rpx 0 0;padding:0 28rpx;border:1rpx solid rgba(57,216,122,.5);border-radius:30rpx;background:rgba(57,216,122,.08);color:#39d87a;font-size:24rpx;line-height:60rpx}.retry-button::after{border:0}.trend-scroll{width:100%;margin-top:24rpx}.trend-points{display:flex;align-items:flex-end;min-width:100%;height:190rpx;padding:14rpx 8rpx 0;border-radius:20rpx;background:linear-gradient(180deg,rgba(8,23,15,.82),rgba(13,18,15,.48));box-sizing:border-box}.trend-point{display:flex;flex:1;flex-direction:column;align-items:center;min-width:48rpx}.range-month .trend-point{min-width:34rpx}.trend-track{display:flex;align-items:flex-end;width:26rpx;height:122rpx;border-radius:13rpx;background:rgba(255,255,255,.035);overflow:hidden}.trend-bar{width:100%;border-radius:13rpx;background:linear-gradient(180deg,#72e7af,#189764)}.trend-label{margin-top:8rpx;color:rgba(255,255,255,.32);font-size:18rpx}.trend-point-current .trend-label{color:#75e2aa}.trend-empty{margin-top:24rpx;padding:34rpx 24rpx;border-radius:20rpx;background:rgba(255,255,255,.025);color:rgba(255,255,255,.42);font-size:22rpx;line-height:1.6;text-align:center}.trend-stats{display:flex;gap:14rpx;margin-top:18rpx}.trend-stats>view{flex:1;padding:18rpx;border-radius:18rpx;background:rgba(255,255,255,.025)}.trend-stats text{display:block;color:rgba(255,255,255,.4);font-size:20rpx}.trend-stats .trend-stat-value{margin-top:10rpx;color:#fff;font-size:27rpx;font-weight:500}.honest-empty-card{min-height:220rpx}.empty-title{display:block;margin-top:34rpx;font-size:30rpx;color:#fff}.empty-description{display:block;margin-top:14rpx;font-size:22rpx;line-height:1.7;color:rgba(255,255,255,.46)}
