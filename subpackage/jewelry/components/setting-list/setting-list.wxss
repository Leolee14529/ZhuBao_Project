.setting-section{margin-bottom:34rpx}.setting-title{display:block;margin:0 0 14rpx 26rpx;color:rgba(255,255,255,.3);font-size:22rpx;font-weight: 500;letter-spacing:3rpx;text-transform:uppercase}.setting-card{overflow:hidden;border-radius:30rpx;background:rgba(255,255,255,.055);border:1rpx solid rgba(255,255,255,.07)}.setting-row{min-height:104rpx;padding:20rpx 26rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid rgba(255,255,255,.06)}.setting-row:last-child{border-bottom:0}.row-left,.row-right{display:flex;align-items:center;gap:18rpx}.row-icon{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;border-radius:15rpx;background:rgba(255,255,255,.06);color:rgba(255,255,255,.7);font-size:19rpx;font-weight: 500}.row-label{color:rgba(255,255,255,.9);font-size:28rpx;font-weight:500}.row-value{color:rgba(255,255,255,.42);font-size:24rpx}.arrow{color:rgba(255,255,255,.25);font-size:48rpx;line-height:1}.toggle{width:80rpx;height:44rpx;padding:6rpx;border-radius:999rpx;background:rgba(255,255,255,.1)}.toggle view{width:32rpx;height:32rpx;border-radius:50%;background:#fff;transition:transform .2s}.toggle.on{background:#059669}.toggle.on view{transform:translateX(36rpx)}