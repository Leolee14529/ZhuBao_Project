<view class="bottom-nav">
  <block wx:for="{{tabs}}" wx:key="id">
    <button class="nav-item {{item.id === active ? 'active' : ''}}" data-tab="{{item.id}}" bindtap="switchTab">
      <view class="nav-top"></view>
      <view class="nav-icon {{item.iconClass}}">
        <block wx:if="{{item.id === 'home'}}">
          <view class="home-roof"></view>
          <view class="home-body"></view>
        </block>
        <block wx:elif="{{item.id === 'data'}}">
          <view class="wave-line wave-left"></view>
          <view class="wave-line wave-mid"></view>
          <view class="wave-line wave-right"></view>
        </block>
        <block wx:elif="{{item.id === 'settings'}}">
          <view class="gear-core"></view>
          <view class="gear-tooth gear-top"></view>
          <view class="gear-tooth gear-right"></view>
          <view class="gear-tooth gear-bottom"></view>
          <view class="gear-tooth gear-left"></view>
        </block>
      </view>
      <text class="nav-label">{{item.label}}</text>
    </button>
  </block>
</view>
