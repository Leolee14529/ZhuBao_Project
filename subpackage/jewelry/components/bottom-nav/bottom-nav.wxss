.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 80;
  height: 112rpx;
  height: 146rpx;
  height: calc(112rpx + constant(safe-area-inset-bottom));
  height: calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 8rpx 18rpx 0;
  padding: 8rpx 18rpx 34rpx;
  padding: 8rpx 18rpx constant(safe-area-inset-bottom);
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  border-radius: 26rpx 26rpx 0 0;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-bottom: 0;
  background: #070708;
  box-shadow: 0 -8rpx 30rpx rgba(0,0,0,0.34), 0 0 38rpx rgba(0,212,148,0.08);
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  overflow: hidden;
}
.bottom-nav::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 4rpx;
  background-color: #070708;
  pointer-events: none;
}
.nav-item { position: relative; flex: 1; min-width: 0; height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0; background: transparent; border: 0; color: rgba(255,255,255,0.4); line-height: 1; }
.nav-item::after { border: 0; }
.nav-top { position: absolute; top: -8rpx; width: 54rpx; height: 6rpx; border-radius: 999rpx; background: transparent; }
.nav-icon { position: relative; width: 42rpx; height: 42rpx; margin: 0 auto; }
.nav-label { margin-top: 9rpx; font-size: 20rpx; font-weight: 500; }
.nav-item.active { color: #00d494; }
.nav-item.active .nav-top { background: #00d494; box-shadow: 0 0 16rpx rgba(0,212,148,0.58); }
.icon-home .home-roof { position: absolute; left: 6rpx; top: 4rpx; width: 28rpx; height: 28rpx; border-left: 4rpx solid currentColor; border-top: 4rpx solid currentColor; transform: rotate(45deg); }
.icon-home .home-body { position: absolute; left: 10rpx; bottom: 5rpx; width: 20rpx; height: 16rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 6rpx 6rpx; }
.icon-wave .wave-line { position: absolute; bottom: 14rpx; width: 9rpx; border-bottom: 3rpx solid currentColor; border-radius: 0 0 10rpx 10rpx; }
.icon-wave .wave-left { left: 5rpx; height: 7rpx; }
.icon-wave .wave-mid { left: 16rpx; height: 13rpx; }
.icon-wave .wave-right { left: 27rpx; height: 7rpx; }
.icon-gear { border: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.icon-gear .gear-core { position: absolute; left: 50%; top: 50%; width: 10rpx; height: 10rpx; margin-left: -5rpx; margin-top: -5rpx; border-radius: 50%; background: currentColor; }
.icon-gear .gear-tooth { position: absolute; left: 50%; top: 50%; width: 4rpx; height: 9rpx; margin-left: -2rpx; margin-top: -19rpx; border-radius: 999rpx; background: currentColor; transform-origin: center 19rpx; }
.icon-gear .gear-top { transform: rotate(0deg); }
.icon-gear .gear-right { transform: rotate(90deg); }
.icon-gear .gear-bottom { transform: rotate(180deg); }
.icon-gear .gear-left { transform: rotate(270deg); }
