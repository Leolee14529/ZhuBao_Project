.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 80;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 28rpx;
  border: 1rpx solid rgba(230,255,244,0.12);
  background: rgba(7,10,10,0.74);
  box-shadow: 0 14rpx 40rpx rgba(0,0,0,0.34), 0 1rpx 0 rgba(255,255,255,0.06) inset;
  backdrop-filter: blur(20rpx);
}
.nav-item { position: relative; flex: 1; height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0; background: transparent; border: 0; color: rgba(255,255,255,0.66); line-height: 1; }
.nav-item::after { border: 0; }
.nav-label { font-size: 28rpx; font-weight: 500; line-height: 36rpx; }
.nav-indicator { width: 32rpx; height: 4rpx; margin-top: 8rpx; border-radius: 999rpx; background: transparent; }
.nav-item.active { color: #00d494; }
.nav-item.active .nav-label { font-size: 30rpx; font-weight: 700; text-shadow: 0 1rpx 6rpx rgba(0,212,148,0.34); }
.nav-item.active .nav-indicator { background: #00d494; box-shadow: 0 0 12rpx rgba(0,212,148,0.3); }
.nav-item-pressed { border-radius: 20rpx; background: rgba(255,255,255,0.06); }
