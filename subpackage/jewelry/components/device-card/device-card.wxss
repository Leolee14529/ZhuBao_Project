.device-card {
  overflow: hidden;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.2);
  background:
    linear-gradient(180deg, rgba(8, 15, 12, 0.96), rgba(10, 19, 15, 0.92)),
    radial-gradient(circle at left, rgba(36, 166, 108, 0.12), transparent 35%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.02);
}

.device-icon-wrap {
  float: left;
  width: 68rpx;
  height: 68rpx;
  margin-top: 10rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background-color: rgba(57, 216, 122, 0.1);
}

.device-icon-image {
  width: 68rpx;
  height: 68rpx;
}

.device-main {
  float: left;
  margin-left: 22rpx;
}

.device-name {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
}

.device-side {
  float: right;
  padding-top: 2rpx;
}

.device-status-row,
.device-battery-row {
  overflow: hidden;
}

.device-battery-row {
  margin-top: 16rpx;
}

.device-status-dot {
  float: left;
  width: 12rpx;
  height: 12rpx;
  margin-top: 9rpx;
  border-radius: 6rpx;
  background-color: rgba(255, 255, 255, 0.32);
}

.device-status {
  float: left;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.52);
}

.device-status-dot.device-connected {
  background-color: #39d87a;
  box-shadow: 0 0 12rpx rgba(57, 216, 122, 0.6);
}

.device-status.device-connected {
  color: #39d87a;
}

.battery-icon {
  position: relative;
  float: left;
  width: 34rpx;
  height: 18rpx;
  margin-top: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 4rpx;
}

.battery-cap {
  position: absolute;
  right: -6rpx;
  top: 4rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 0 2rpx 2rpx 0;
  background-color: rgba(255, 255, 255, 0.72);
}

.battery-level {
  position: absolute;
  left: 3rpx;
  top: 3rpx;
  width: 22rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background-color: #8df2a8;
}

.device-battery {
  float: left;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}
