.product-card{overflow:hidden;border-radius:32rpx;background:#0a0a0a;border:1rpx solid rgba(255,255,255,0.06)}
.image-wrap{position:relative;width:100%;height:350rpx;overflow:hidden}.product-image{width:100%;height:100%;opacity:.94}.shade{position:absolute;left:0;right:0;bottom:0;height:52%;background:linear-gradient(180deg,transparent,rgba(0,0,0,.76))}.tag{position:absolute;top:18rpx;left:18rpx;padding:4rpx 14rpx;border-radius:5rpx;background:#10b981;color:#06100c;font-size:20rpx;font-weight: 500}.product-meta{min-height:100rpx;padding:18rpx 20rpx 20rpx;display:flex;justify-content:space-between;gap:12rpx}.name{display:block;color:rgba(255,255,255,.92);font-size:28rpx;font-weight:500}.type{display:block;margin-top:6rpx;color:rgba(255,255,255,.36);font-size:20rpx}.note{color:#34d399;font-size:24rpx;font-weight: 500;white-space:nowrap}
