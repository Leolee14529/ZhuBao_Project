.editor-mask{position:fixed;z-index:300;inset:0;display:flex;align-items:flex-end;background:rgba(0,0,0,.72)}.editor-sheet{width:100%;max-height:88vh;overflow-y:auto;padding:30rpx 28rpx calc(32rpx + constant(safe-area-inset-bottom));padding:30rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#15171c;box-sizing:border-box}.editor-head{display:flex;align-items:center;justify-content:space-between;width:100%;min-width:0;box-sizing:border-box}.editor-title{flex:0 1 auto;min-width:0;font-size:34rpx;color:#fff}.editor-close{margin-left:auto;flex:0 0 auto;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:flex-end}.editor-close-icon{color:rgba(255,255,255,.6);font-size:48rpx;line-height:64rpx}.score-option::after,.tag-option::after,.save-button::after{border:0}.form-group{margin-top:28rpx}.form-row{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx}.form-label{display:block;margin-bottom:14rpx;font-size:24rpx;color:rgba(255,255,255,.72)}.form-row .form-label{margin:0}.score-options{display:flex;gap:14rpx}.score-option{flex:1;margin:0;padding:0;border:1rpx solid rgba(255,255,255,.1);border-radius:18rpx;background:#20232a;color:rgba(255,255,255,.6);font-size:26rpx;line-height:68rpx}.score-option-active{border-color:#39d87a;background:rgba(57,216,122,.14);color:#74e3ac}.sleep-inputs{display:flex;align-items:center;gap:12rpx}.sleep-input{width:116rpx;height:68rpx;padding:0 16rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:16rpx;background:#20232a;color:#fff;text-align:center;box-sizing:border-box}.sleep-unit{font-size:22rpx;color:rgba(255,255,255,.45)}.tag-options{display:flex;flex-wrap:wrap;gap:12rpx}.tag-option{margin:0;padding:0 20rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:24rpx;background:#20232a;color:rgba(255,255,255,.58);font-size:22rpx;line-height:52rpx}.tag-option-active{border-color:#39d87a;background:rgba(57,216,122,.12);color:#74e3ac}.editor-textarea{width:100%;height:150rpx;padding:18rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:18rpx;background:#20232a;color:#fff;font-size:24rpx;box-sizing:border-box}.save-button{margin-top:34rpx;border-radius:24rpx;background:#16c784;color:#04120c;font-size:28rpx;font-weight:600;line-height:88rpx}
