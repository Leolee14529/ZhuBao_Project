.section-card{margin-bottom:28rpx;padding:30rpx;border-radius:36rpx;background:rgba(255,255,255,.055);border:1rpx solid rgba(255,255,255,.07);backdrop-filter:blur(24rpx)}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28rpx}.section-title{display:block;color:#fff;font-size:32rpx;font-weight:300}.section-subtitle{display:block;margin-top:8rpx;color:rgba(255,255,255,.4);font-size:22rpx}