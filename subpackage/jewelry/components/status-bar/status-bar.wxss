.status-bar { position: relative; z-index: 20; display: flex; align-items: center; justify-content: space-between; padding: 22rpx 42rpx 16rpx; color: rgba(255,255,255,0.9); font-size: 26rpx; font-weight: 500; }
.status-time { width: 140rpx; text-align: center; letter-spacing: 1rpx; }
.status-notch { position: absolute; left: 50%; top: -32rpx; width: 210rpx; height: 56rpx; transform: translateX(-50%); border-radius: 999rpx; background: rgba(0,0,0,0.48); border: 1rpx solid rgba(255,255,255,0.06); }
.status-icons { width: 150rpx; display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; }
.signal { display: flex; align-items: flex-end; gap: 4rpx; height: 24rpx; }
.signal view { width: 5rpx; background: #fff; border-radius: 4rpx; }
.signal view:nth-child(1) { height: 9rpx; opacity: 0.55; }
.signal view:nth-child(2) { height: 15rpx; opacity: 0.75; }
.signal view:nth-child(3) { height: 22rpx; }
.wifi { font-size: 18rpx; color: rgba(255,255,255,0.78); }
.battery { width: 40rpx; height: 20rpx; border: 2rpx solid rgba(255,255,255,0.55); border-radius: 5rpx; padding: 3rpx; }
.battery view { width: 24rpx; height: 10rpx; background: #fff; border-radius: 2rpx; }