<view class="element-radar-card">
  <view class="radar-aura"></view>
  <view class="radar-header">
    <text class="radar-title">{{title}}</text>
    <text class="radar-subtitle">{{subtitle}}</text>
  </view>

  <view class="radar-stage">
    <canvas canvas-id="elementRadarCanvas" class="radar-canvas"></canvas>
    <cover-view class="radar-label label-wood">Emerald</cover-view>
    <cover-view class="radar-label label-fire">Red Violet</cover-view>
    <cover-view class="radar-label label-earth">Honey</cover-view>
    <cover-view class="radar-label label-metal">Silver White</cover-view>
    <cover-view class="radar-label label-water">Blue Black</cover-view>
  </view>

  <text class="radar-status">{{note}}</text>
</view>
