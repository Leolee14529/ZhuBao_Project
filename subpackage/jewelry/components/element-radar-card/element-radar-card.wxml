<view class="element-radar-card">
  <view class="radar-aura"></view>
  <view class="radar-header">
    <text class="radar-title">{{title}}</text>
    <text class="radar-subtitle">{{subtitle}}</text>
  </view>

  <view class="radar-stage">
    <canvas canvas-id="elementRadarCanvas" class="radar-canvas"></canvas>
    <cover-view class="radar-label label-wood">木</cover-view>
    <cover-view class="radar-label label-fire">火</cover-view>
    <cover-view class="radar-label label-earth">土</cover-view>
    <cover-view class="radar-label label-metal">金</cover-view>
    <cover-view class="radar-label label-water">水</cover-view>
  </view>

  <text class="radar-status">{{note}}</text>
</view>
