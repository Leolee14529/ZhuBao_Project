<view class="element-radar-card">
  <view class="radar-aura"></view>
  <view class="radar-header">
    <text class="radar-title">{{title}}</text>
    <text class="radar-subtitle">{{subtitle}}</text>
  </view>

  <view class="radar-stage">
    <canvas canvas-id="elementRadarCanvas" class="radar-canvas"></canvas>
    <cover-view class="radar-label label-wood">翠绿</cover-view>
    <cover-view class="radar-label label-fire">红紫</cover-view>
    <cover-view class="radar-label label-earth">蜜糖</cover-view>
    <cover-view class="radar-label label-metal">银白</cover-view>
    <cover-view class="radar-label label-water">蓝黑</cover-view>
  </view>

  <text class="radar-status">{{note}}</text>
</view>
