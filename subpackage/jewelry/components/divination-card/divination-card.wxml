<view class="divination-card {{cardClass}}" bindtap="toggle">
  <view class="divination-front">
    <view class="divination-grid"></view>
    <view class="divination-head">
      <view class="divination-label">
        <view class="divination-dot"></view>
        <text>每日灵签</text>
      </view>
      <text class="divination-no">{{fortune.no}}</text>
    </view>
    <view class="divination-center">
      <view class="divination-ring">
        <view class="divination-ring-inner"></view>
        <text class="divination-symbol">{{fortune.symbol}}</text>
      </view>
      <text class="divination-title">{{fortune.title}}</text>
      <text class="divination-subtitle">{{fortune.subtitle}}</text>
    </view>
    <view class="divination-copy">
      <text class="divination-quote">“</text>
      <text class="divination-text">{{fortune.text}}</text>
    </view>
  </view>
  <view class="divination-back">
    <view class="divination-back-grid"></view>
    <view class="divination-back-core"></view>
    <text class="divination-back-title">COMPUTING POWER</text>
    <text class="divination-back-tip">点击翻面</text>
  </view>
</view>
