.divination-card {
  position: relative;
  overflow: hidden;
  min-height: 610rpx;
  margin-bottom: 44rpx;
  border-radius: 34rpx;
  background-color: #0f1714;
  border: 1rpx solid rgba(16, 185, 129, 0.22);
}
.divination-front {
  display: block;
  padding: 30rpx 42rpx 42rpx;
}
.divination-grid,
.divination-back-grid {
  position: absolute;
  inset: 0;
  opacity: 0.12;
  background-image: linear-gradient(rgba(16, 185, 129, 0.2) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(16, 185, 129, 0.2) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
}
.divination-head {
  position: relative;
  overflow: hidden;
  margin-bottom: 76rpx;
}
.divination-label {
  float: left;
  font-size: 26rpx;
  color: #39d87a;
}
.divination-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background-color: #39d87a;
}
.divination-no {
  float: right;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.34);
}
.divination-center {
  position: relative;
  text-align: center;
  margin-bottom: 56rpx;
}
.divination-ring {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  margin: 0 auto 28rpx;
  border-radius: 92rpx;
  border: 1rpx solid rgba(57, 216, 122, 0.28);
}
.divination-ring-inner {
  position: absolute;
  inset: 24rpx;
  border-radius: 68rpx;
  border: 4rpx solid rgba(57, 216, 122, 0.8);
}
.divination-symbol {
  display: block;
  line-height: 184rpx;
  text-align: center;
  font-size: 82rpx;
  color: #ffffff;
}
.divination-title {
  display: block;
  font-size: 56rpx;
  color: #ffffff;
}
.divination-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}
.divination-copy {
  position: relative;
  min-height: 150rpx;
  padding: 30rpx 30rpx 28rpx 70rpx;
  border-radius: 24rpx;
  background-color: rgba(0, 0, 0, 0.34);
}
.divination-quote {
  position: absolute;
  left: 34rpx;
  top: 28rpx;
  font-size: 44rpx;
  color: #39d87a;
}
.divination-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(220, 252, 231, 0.92);
}
.divination-back {
  display: none;
  position: relative;
  min-height: 610rpx;
  padding-top: 180rpx;
  text-align: center;
  background-color: #0a120f;
}
.divination-card-flipped .divination-front {
  display: none;
}
.divination-card-flipped .divination-back {
  display: block;
}
.divination-back-core {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border: 2rpx solid rgba(57, 216, 122, 0.4);
  transform: rotate(45deg);
}
.divination-back-title,
.divination-back-tip {
  display: block;
  color: rgba(57, 216, 122, 0.75);
}
.divination-back-title {
  font-size: 26rpx;
  letter-spacing: 6rpx;
}
.divination-back-tip {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.26);
}
