.divination{position:relative;width:100%;height:690rpx;margin-bottom:30rpx;border-radius:46rpx;overflow:hidden;color:#fff;box-shadow:0 0 80rpx rgba(16,185,129,.2)}.face{position:absolute;left:0;right:0;top:0;bottom:0;padding:42rpx;border-radius:46rpx;border:1rpx solid rgba(16,185,129,.28);transition:opacity .3s,transform .3s}.front{background:linear-gradient(135deg,#0f2e22,#000);opacity:1;transform:scale(1)}.back{background:#050f0c;opacity:0;transform:scale(.96);display:flex;align-items:center;justify-content:center}.flipped .front{opacity:0;transform:scale(.96)}.flipped .back{opacity:1;transform:scale(1)}.pattern{position:absolute;left:0;right:0;top:0;bottom:0;opacity:.18;background-image:radial-gradient(circle at 50% 50%,rgba(16,185,129,.5) 2rpx,transparent 2rpx);background-size:48rpx 48rpx}.glow{position:absolute;top:-20rpx;right:-40rpx;width:300rpx;height:300rpx;background:rgba(16,185,129,.2);filter:blur(80rpx);border-radius:50%}.top-line{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center}.label{display:flex;align-items:center;gap:12rpx;color:rgba(52,211,153,.82);font-size:22rpx;letter-spacing:5rpx}.label view{width:11rpx;height:11rpx;border-radius:50%;background:#34d399;box-shadow:0 0 20rpx #34d399}.number{color:rgba(255,255,255,.32);font-size:22rpx}.center-mark{position:relative;z-index:2;height:385rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.ring{position:relative;width:182rpx;height:182rpx;display:flex;align-items:center;justify-content:center;margin-bottom:34rpx;border:1rpx solid rgba(16,185,129,.28);border-radius:50%}.spin-ring{position:absolute;inset:-22rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:50%}.ring text{font-size:88rpx;font-family:"SimHei","STHeiti","Heiti SC","PingFang SC","Microsoft YaHei",sans-serif!important;text-shadow:0 0 30rpx rgba(255,255,255,.5)}.fortune{font-size:56rpx;font-family:"SimHei","STHeiti","Heiti SC","PingFang SC","Microsoft YaHei",sans-serif!important;letter-spacing:10rpx}.element{margin-top:14rpx;color:rgba(255,255,255,.5);font-size:22rpx;letter-spacing:3rpx}.interpretation{position:relative;z-index:2;display:flex;gap:18rpx;padding:26rpx;border-radius:24rpx;border:1rpx solid rgba(255,255,255,.06);background:rgba(0,0,0,.42)}.quote{color:#10b981;font-size:42rpx;line-height:1}.grid{position:absolute;left:0;right:0;top:0;bottom:0;opacity:.12;background-image:linear-gradient(rgba(16,185,129,.45) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(16,185,129,.45) 1rpx,transparent 1rpx);background-size:72rpx 72rpx}.diamond{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:20rpx;color:rgba(16,185,129,.58);letter-spacing:9rpx;font-size:24rpx}.diamond view{width:142rpx;height:142rpx;border:1rpx solid rgba(16,185,129,.36);transform:rotate(45deg);box-shadow:inset 0 0 40rpx rgba(16,185,129,.1)}.hint{position:absolute;bottom:38rpx;color:rgba(255,255,255,.24);font-size:20rpx;text-transform:uppercase;letter-spacing:2rpx}
