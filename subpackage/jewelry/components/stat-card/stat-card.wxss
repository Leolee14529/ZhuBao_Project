.stat-card{position:relative;height:214rpx;padding:30rpx;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;border-radius:30rpx;background:rgba(10,10,10,.82);border:1rpx solid rgba(255,255,255,.09)}.ghost{position:absolute;right:-22rpx;top:-20rpx;width:132rpx;height:132rpx;border-radius:44rpx;opacity:.08;transform:rotate(28deg);background:currentColor}.stat-label{display:flex;align-items:center;gap:10rpx;color:rgba(255,255,255,.42);font-size:20rpx;letter-spacing:0}.dot{width:9rpx;height:9rpx;border-radius:50%;background:currentColor}.stat-value{display:block;color:#fff;font-size:34rpx;font-weight:500}.stat-desc{display:block;margin-top:6rpx;color:rgba(255,255,255,.48);font-size:20rpx}.emerald{color:#34d399}.rose{color:#fb7185}.blue{color:#60a5fa}.amber{color:#f59e0b}