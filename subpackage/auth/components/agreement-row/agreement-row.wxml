<view class="agreement-row" bindtap="onToggle">
  <view class="agreement-row__check {{checked ? 'agreement-row__check--on' : ''}}">
    <text wx:if="{{checked}}" class="agreement-row__tick">✓</text>
  </view>
  <text class="agreement-row__text">I have read and agree to the User Agreement and the Privacy Policy</text>
</view>
