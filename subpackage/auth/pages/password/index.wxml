<view class="auth-page">
  <view class="auth-page__inner" style="padding-top: {{statusBarHeight}}px;">
    <view class="auth-page__topbar">
      <navigation-back mode="back" aria-label="Back"></navigation-back>
    </view>

    <view class="auth-page__content">
      <auth-intro title="Create Password" subtitle="Enter an 8-16 character password with letters, numbers, and symbols."></auth-intro>
      <empty-state
        wx:if="{{serviceError}}"
        class="auth-page__error-state"
        title="Cannot continue right now"
        desc="{{serviceError}}"
        buttonText="Retry"
        type="auth"
        compact="{{true}}"
        bind:action="retryNext"
      ></empty-state>
      <dark-input-field
        value="{{password}}"
        password="{{!showPassword}}"
        visible="{{showPassword}}"
        placeholder="Enter password"
        toggleable="{{true}}"
        bind:input="onPasswordInput"
        bind:toggle="onTogglePassword"
      ></dark-input-field>
      <dark-input-field
        value="{{confirmPassword}}"
        password="{{!showConfirm}}"
        visible="{{showConfirm}}"
        placeholder="Confirm password"
        toggleable="{{true}}"
        bind:input="onConfirmInput"
        bind:toggle="onToggleConfirm"
      ></dark-input-field>
      <form-error-text message="{{errorText}}"></form-error-text>
      <view class="auth-page__primary auth-page__primary--spaced" bindtap="onNext">Next</view>
    </view>

    <view class="auth-page__agreement">
      <agreement-row checked="{{agreed}}" bind:toggle="onAgreementToggle"></agreement-row>
    </view>
  </view>
</view>
