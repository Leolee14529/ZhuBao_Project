<view class="auth-page">
  <view class="auth-page__inner" style="padding-top: {{statusBarHeight}}px;">
    <view class="auth-page__topbar">
      <navigation-back mode="back" aria-label="Back"></navigation-back>
    </view>

    <view class="auth-page__content">
      <auth-intro title="Create Account" subtitle="Enter the email address for your verification code"></auth-intro>
      <empty-state
        wx:if="{{serviceError}}"
        class="auth-page__error-state"
        title="Cannot continue right now"
        desc="{{serviceError}}"
        buttonText="Retry"
        type="auth"
        compact="{{true}}"
        bind:action="retryNext"
      ></empty-state>
      <dark-input-field icon="✉" value="{{email}}" placeholder="Enter email" bind:input="onEmailInput"></dark-input-field>
      <form-error-text message="{{errorText}}"></form-error-text>
      <view class="auth-page__primary" bindtap="onNext">Next</view>
    </view>

    <view class="auth-page__agreement">
      <agreement-row checked="{{agreed}}" bind:toggle="onAgreementToggle"></agreement-row>
    </view>
  </view>
</view>
