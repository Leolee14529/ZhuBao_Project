.hero {
  margin-top: 8rpx;
  text-align: center;
}

.hero-image {
  width: 420rpx;
  margin: 0 auto;
  display: block;
}

.hero-name {
  display: block;
  margin-top: 8rpx;
  font-size: 60rpx;
  font-weight: 500;
  color: #ffffff;
}

.hero-status {
  display: block;
  margin-top: 20rpx;
  font-size: 46rpx;
  font-weight: 500;
  color: #ff2d55;
}

.hero-helper {
  display: block;
  margin-top: 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.5);
}
