.section-card {
  margin-top: 52rpx;
  padding: 34rpx 36rpx 16rpx;
  border-radius: 34rpx;
  background: rgba(13, 19, 29, 0.88);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.03);
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 44rpx;
  font-weight: 500;
  color: #ffffff;
}

.row {
  display: block;
  width: 100%;
  min-height: 116rpx;
  padding: 0;
  background: transparent;
}

.row-content {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 116rpx;
}

.row-left {
  display: flex;
  align-items: center;
  width: 220rpx;
  flex-shrink: 0;
}

.row-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 24rpx;
}

.row-label {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.76);
  white-space: nowrap;
}

.row-right {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  justify-content: flex-start;
  text-align: left;
}

.row-right-align-right {
  justify-content: flex-end;
}

.row-value {
  display: block;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.66);
  text-align: left;
  word-break: break-word;
}

.row-value-danger {
  color: #ff2d55;
}

.row-value-brand {
  color: #2f95ff;
}

.row-spinner {
  width: 34rpx;
  height: 34rpx;
  margin-left: 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.18);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: row-spinner-rotate 0.9s linear infinite;
}

.row-arrow {
  margin-left: 18rpx;
  font-size: 52rpx;
  color: rgba(255, 255, 255, 0.44);
}

@keyframes row-spinner-rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
