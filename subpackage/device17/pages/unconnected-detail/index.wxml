<view class="device-detail-page" style="padding-top: {{statusBarHeight}}px;">
  <device-topbar />

  <view class="page-content">
    <text class="page-title">Device Connection</text>

    <device-hero
      image-src="/subpackage/device17/assets/ring-status.png"
      ring-name="No device"
      status-text="Disconnected"
      helper-text="Connect the device first"
    />

    <device-section-card
      title="Device Info"
      rows="{{infoRows}}"
      bind:select="onInfoSelect"
    />

    <device-section-card
      class="connection-card"
      title="Connection"
      rows="{{connectionRows}}"
      bind:select="onConnectionSelect"
    />

    <view class="search-button-row">
      <primary-button
        class="search-button-component"
        style="display: block; width: 100%;"
        text="SearchDevice"
        bind:action="onSearchDevice"
      />
    </view>
  </view>
</view>
