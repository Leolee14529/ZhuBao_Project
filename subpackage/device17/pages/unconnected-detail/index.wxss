.device-detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(87, 12, 22, 0.22), transparent 28%),
    linear-gradient(180deg, #03060d 0%, #02050b 100%);
  color: #ffffff;
}

.page-content {
  padding: 0 36rpx 42rpx;
}

.page-title {
  display: block;
  margin-top: 4rpx;
  text-align: center;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.device-empty-state {
  display: block;
  margin-top: 36rpx;
}

.connection-card {
  display: block;
  margin-top: 28rpx;
}

.search-button-row {
  width: 100%;
}
