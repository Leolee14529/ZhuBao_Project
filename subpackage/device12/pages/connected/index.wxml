<view class="connected-page" style="padding-top: {{statusBarHeight}}px;">
  <device-topbar />

  <view class="page-content">
    <text class="page-title">Device Connection</text>

    <empty-state
      wx:if="{{deviceStatus === 'failed'}}"
      class="device-empty-state"
      title="Device disconnected"
      desc="Reconnect the device to continue syncing health and wear data"
      buttonText="Reconnect"
      type="device"
      bind:action="onReconnect"
    ></empty-state>

    <block wx:else>
    <connected-hero
      image-src="/subpackage/device12/assets/ring-connected.png"
      ring-name="No device"
      status-text="Disconnected"
      battery-text="Battery 0%"
    />

    <device-section-card
      title="Device Info"
      rows="{{infoRows}}"
      bind:select="onInfoSelect"
    />

    <device-section-card
      class="connection-card"
      title="Connection"
      rows="{{connectionRows}}"
      bind:select="onConnectionSelect"
    />

    <disconnect-button text="Disconnect" bind:action="onDisconnect" />
    </block>
  </view>
</view>
