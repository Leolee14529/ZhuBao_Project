.calendar-page,
.month-switcher,
.calendar-grid,
.legend-row {
  font-family: "STSongti-SC-Regular", "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", "NSimSun", serif !important;
  font-variant-numeric: lining-nums tabular-nums;
}

.cycle-setup-sheet,
.calendar-grid--compact {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif !important;
  font-variant-numeric: lining-nums tabular-nums;
}

.nav-circle,
.setup-calendar-nav,
.cycle-stepper__button,
.cycle-setup-sheet__button {
  font-family: inherit !important;
}
