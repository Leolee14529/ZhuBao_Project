@import "../../styles/typography.wxss";

.cycle-setup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.56);
  overflow: hidden;
}
.cycle-setup-sheet {
  width: 100%;
  max-width: 480px;
  max-height: calc(90vh - constant(safe-area-inset-bottom));
  max-height: calc(90vh - env(safe-area-inset-bottom));
  overflow-y: auto;
  padding: 16rpx 24rpx calc(34rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: linear-gradient(180deg, #171b22 0%, #11151b 100%);
  box-sizing: border-box;
}
.cycle-setup-sheet__handle {
  width: 76rpx;
  height: 7rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}
.cycle-setup-sheet__title {
  display: block;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
}
.cycle-setup-sheet__desc {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}
.cycle-privacy-confirm {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(46, 208, 151, 0.18);
  background: rgba(8, 110, 78, 0.14);
  box-sizing: border-box;
  overflow: hidden;
}
.cycle-privacy-confirm__box {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  box-sizing: border-box;
}
.cycle-privacy-confirm__box--checked {
  border-color: #14e29a;
  background: #0d8f68;
}
.cycle-privacy-confirm__mark {
  display: block;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 32rpx;
  text-align: center;
}
.cycle-privacy-confirm__copy {
  flex: 1;
  min-width: 0;
}
.cycle-privacy-confirm__title {
  display: block;
  color: #d7fff1;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.35;
}
.cycle-privacy-confirm__desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 1.45;
}
.setup-calendar-card,
.cycle-field {
  margin-top: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}
.setup-calendar-card {
  padding: 18rpx 12rpx 16rpx;
  overflow: hidden;
}
.cycle-field {
  padding: 20rpx 22rpx;
}
.setup-calendar-head,
.cycle-field__header,
.setup-selected-date,
.cycle-stepper,
.cycle-setup-sheet__actions {
  display: flex;
  align-items: center;
}
.setup-calendar-head,
.cycle-field__header,
.setup-selected-date,
.cycle-stepper {
  justify-content: space-between;
}
.setup-calendar-head {
  min-height: 58rpx;
  padding: 0 4rpx;
  gap: 12rpx;
}
.setup-calendar-nav,
.cycle-stepper__button {
  padding: 0;
  color: #ffffff;
  text-align: center;
}
.setup-calendar-nav {
  flex: none;
  width: 56rpx;
  height: 50rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.05);
  font-size: 30rpx;
  line-height: 1;
  white-space: nowrap;
}
.setup-calendar-nav::after,
.cycle-stepper__button::after {
  border: 0;
}
.setup-calendar-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  text-align: center;
}
.setup-calendar-title {
  display: block;
  max-width: 100%;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.setup-calendar-subtitle {
  display: block;
  max-width: 100%;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.setup-selected-date {
  gap: 14rpx;
  margin: 16rpx 10rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 61, 113, 0.1);
  border: 1rpx solid rgba(255, 61, 113, 0.16);
}
.setup-selected-date__label,
.cycle-field__hint {
  flex: none;
  color: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
}
.setup-selected-date__value {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}
.cycle-field__label {
  display: block;
  color: rgba(255, 255, 255, 0.84);
  font-size: 23rpx;
  font-weight: 500;
}
.cycle-field__hint {
  color: rgba(255, 255, 255, 0.42);
}
.cycle-stepper {
  margin-top: 16rpx;
  gap: 14rpx;
}
.cycle-stepper__button {
  flex: none;
  width: 78rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 32rpx;
  line-height: 60rpx;
}
.cycle-stepper__value {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 0;
}
.cycle-stepper__number {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
}
.cycle-stepper__unit {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
}
.cycle-setup-sheet__actions {
  gap: 14rpx;
  margin-top: 22rpx;
  padding-bottom: 8rpx;
  padding-bottom: calc(8rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.cycle-setup-sheet__button {
  flex: 1;
  height: 74rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  min-width: 0;
  text-align: center;
}
.cycle-setup-sheet__button--ghost {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.72);
}
.cycle-setup-sheet__button--primary {
  background: rgba(8, 110, 78, 0.9);
  border: 1rpx solid rgba(46, 208, 151, 0.22);
  color: #8ef0cf;
}
.cycle-setup-sheet__button--disabled {
  opacity: 0.58;
}
