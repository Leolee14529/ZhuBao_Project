<view class="month-switcher">
  <view class="month-row">
    <view class="month-center">
      <view class="nav-circle month-prev" bindtap="onPrevTap">‹</view>
      <text class="month-label">{{monthLabel}}</text>
      <view class="nav-circle month-next" bindtap="onNextTap">›</view>
    </view>
  </view>

  <view class="reminder-bar">
    <text class="reminder-text">今天开始周期了吗？</text>
    <view class="reminder-actions">
      <reference-switch checked="{{periodStartedToday}}" bind:toggle="onToggleTap" />
    </view>
  </view>
</view>
