@import "../../styles/typography.wxss";

.month-switcher {
  width: 100%;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.month-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  height: 64rpx;
}

.month-center {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 64rpx;
  min-width: 0;
  text-align: center;
}


.nav-circle,
.today-button {
  padding: 0;
  border: 0;
}

.nav-circle::after,
.today-button::after,
.switch::after {
  border: 0;
}

.nav-circle {
  position: static;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 64rpx;
  border-radius: 50%;
  background: transparent;
  color: rgba(255, 255, 255, 0.92);
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-sizing: border-box;
}

.month-prev,
.month-next {
  box-shadow: none;
}

.month-prev,
.month-next {
  left: auto;
  right: auto;
}

.month-label {
  display: block;
  position: static;
  flex: 0 1 280rpx;
  min-width: 180rpx;
  margin: 0 16rpx;
  font-size: 38rpx;
  font-weight: 500;
  color: #ffffff;
  white-space: nowrap;
  line-height: 1;
  text-align: center;
  letter-spacing: 0;
}

.reminder-bar {
  margin-top: 24rpx;
  padding: 18rpx 20rpx 18rpx 26rpx;
  min-height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.reminder-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.35;
}

.reminder-actions {
  flex: none;
  display: flex;
  align-items: center;
}
