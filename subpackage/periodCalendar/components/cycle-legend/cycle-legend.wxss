.legend-row {
  margin-top: 38rpx;
  padding: 0 12rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-mark {
  width: 22rpx;
  height: 22rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.legend-period {
  background: #ff3d71;
}

.legend-periodForecast {
  border: 2rpx solid #ff3d71;
  background: transparent;
}

.legend-ovulation {
  border: 2rpx solid #9f59ff;
  background: transparent;
}

.legend-fertile {
  border: 2rpx solid #11de71;
  background: transparent;
}

.legend-safe {
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.22);
}

.legend-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
}
