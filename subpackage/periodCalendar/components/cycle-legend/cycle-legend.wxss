@import "../../styles/typography.wxss";

.legend-row {
  margin-top: 34rpx;
  padding: 0 4rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  width: 50%;
  min-width: 0;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.legend-mark {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.legend-period {
  background: #ff3d71;
  box-shadow: 0 4rpx 10rpx rgba(255, 61, 113, 0.24);
}

.legend-periodForecast {
  border: 2rpx solid #ff6b96;
  background: rgba(255, 61, 113, 0.08);
}

.legend-ovulation {
  border: 2rpx solid #a875ff;
  background: rgba(159, 89, 255, 0.1);
}

.legend-fertile {
  border: 2rpx solid #22df88;
  background: rgba(17, 222, 113, 0.08);
}

.legend-safe {
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.22);
}

.legend-label {
  min-width: 0;
  font-size: 21rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.2;
}
