@import "../../styles/typography.wxss";

.calendar-grid {
  width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.calendar-grid--compact {
  margin-top: 18rpx;
}

.week-header,
.week-row {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.week-header {
  padding: 0 4rpx;
}

.week-label {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 21rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.56);
}

.week-row {
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.calendar-grid--compact .week-row {
  margin-top: 10rpx;
}

.day-cell {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.calendar-grid--compact .day-cell {
  height: 72rpx;
}

.day-ring {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.calendar-grid--compact .day-ring {
  width: 50rpx;
  height: 50rpx;
}

.status-period {
  background: #ff3d71;
  box-shadow: 0 8rpx 18rpx rgba(255, 61, 113, 0.24);
}

.status-periodForecast {
  border-color: #ff6b96;
  background: rgba(255, 61, 113, 0.08);
}

.status-ovulation {
  border-color: #a875ff;
  background: rgba(159, 89, 255, 0.1);
}

.status-fertile {
  border-color: #22df88;
  background: rgba(17, 222, 113, 0.08);
}

.day-ring-today {
  box-shadow: 0 0 0 4rpx rgba(142, 240, 207, 0.1), 0 0 18rpx rgba(17, 222, 113, 0.36);
}

.day-cell-selected .day-ring {
  box-shadow: 0 0 0 5rpx rgba(255, 255, 255, 0.08);
}

.day-cell-selected .day-ring-today {
  box-shadow: 0 0 0 5rpx rgba(255, 255, 255, 0.08), 0 0 18rpx rgba(17, 222, 113, 0.36);
}

.day-text {
  position: relative;
  z-index: 2;
  font-size: 25rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1;
}

.calendar-grid--compact .day-text {
  font-size: 23rpx;
}

.day-muted {
  color: rgba(255, 255, 255, 0.3);
}

.day-safe-dot {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.calendar-grid--compact .day-safe-dot {
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
}

.day-marker {
  width: 4rpx;
  height: 16rpx;
  margin: 7rpx auto 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, #ffffff 100%);
  opacity: 0.84;
}

.calendar-grid--compact .day-marker {
  height: 12rpx;
  margin-top: 5rpx;
}
