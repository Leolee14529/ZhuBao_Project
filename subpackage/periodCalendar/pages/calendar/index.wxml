<view class="calendar-page" style="padding-top: {{contentTopOffset}}px;">
  <calendar-topbar
    topbar-height="{{topbarHeight}}"
    back-button-top="{{backButtonTop}}"
    bind:back="onBackTap"
  />

  <view class="page-content">
    <month-switcher
      month-label="{{monthLabel}}"
      period-started-today="{{cycleProfile.todayPeriodStartEnabled}}"
      bind:prev="onPrevMonth"
      bind:next="onNextMonth"
      bind:today="onGoToday"
      bind:toggle="onToggleTodayPeriod"
    />

    <view class="calendar-surface">
      <cycle-calendar-grid weeks="{{weeks}}" bind:selectday="onSelectDay" />
      <cycle-legend items="{{legendItems}}" />
    </view>

    <view wx:if="{{!calendarReady}}" class="cycle-state-placeholder">
      <view class="cycle-state-placeholder__line cycle-state-placeholder__line-short"></view>
      <view class="cycle-state-placeholder__line cycle-state-placeholder__line-title"></view>
      <view class="cycle-state-placeholder__line"></view>
      <view class="cycle-state-placeholder__action"></view>
    </view>

    <view wx:elif="{{!hasCycleData}}" class="cycle-preview-card">
      <text class="cycle-preview-card__eyebrow">预览日历</text>
      <text class="cycle-preview-card__title">先用颜色看懂周期，再选择开始日期</text>
      <view class="cycle-preview-card__button" bindtap="onSetupCycle">设置我的周期</view>
      <text class="cycle-preview-card__desc">点“设置我的周期”后，可以直接在月历上选上次周期开始日，系统会按颜色生成周期参考。</text>
    </view>

    <block wx:else>

      <view wx:if="{{selectedDetail}}" class="detail-card">
        <text class="detail-date">{{selectedDetail.fullDate}}</text>
        <view class="detail-row">
          <text class="detail-label">状态：</text>
          <text class="detail-value">{{selectedDetail.statusLabel}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">备注：</text>
          <text class="detail-value">{{selectedDetail.remark}}</text>
        </view>
      </view>

      <view class="summary-block">
        <text class="summary-title">距离下次参考日期还有</text>
        <text class="summary-value">{{summaryDays}}天</text>
        <text class="summary-note">{{summaryNextStart}}</text>
        <view class="summary-action" bindtap="onSetupCycle">调整周期</view>
        <view class="summary-clear-action" bindtap="onClearCycleData">清除本机周期记录</view>
      </view>
    </block>
  </view>

  <cycle-setup-sheet
    wx:if="{{showCycleSetup}}"
    cycle-profile="{{cycleProfile}}"
    today-date-key="{{todayDateKey}}"
    cycle-privacy-confirmed="{{cyclePrivacyConfirmed}}"
    is-saving-cycle="{{isSavingCycle}}"
    bind:close="onCloseCycleSetup"
    bind:toggleprivacy="onToggleCyclePrivacy"
    bind:save="onSaveCycleSetup"
  />
</view>
