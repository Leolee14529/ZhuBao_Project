<view class="calendar-page" style="padding-top: {{statusBarHeight}}px;">
  <calendar-topbar
    topbar-height="{{topbarHeight}}"
    back-button-top="{{backButtonTop}}"
    bind:back="onBackTap"
  />

  <view class="page-content">
    <text class="page-title">{{copy.title}}</text>

    <month-switcher
      month-label="{{monthLabel}}"
      period-started-today="{{cycleProfile.todayPeriodStartEnabled}}"
      bind:prev="onPrevMonth"
      bind:next="onNextMonth"
      bind:today="onGoToday"
      bind:toggle="onToggleTodayPeriod"
    />

    <view wx:if="{{!hasCycleData}}" class="cycle-empty-state">
      <view class="cycle-empty-state__icon-wrap">
        <view class="cycle-empty-state__icon-bg">
          <view class="cycle-empty-state__icon-ring"></view>
          <view class="cycle-empty-state__icon-pulse"></view>
          <view class="cycle-empty-state__icon-dot"></view>
        </view>
      </view>
      <text class="cycle-empty-state__title">{{copy.emptyTitle}}</text>
      <text class="cycle-empty-state__desc">{{copy.emptyDesc}}</text>
      <view class="cycle-empty-state__button" bindtap="onSetupCycle">{{copy.setup}}</view>
    </view>

    <block wx:else>
      <cycle-calendar-grid weeks="{{weeks}}" bind:selectday="onSelectDay" />

      <cycle-legend items="{{legendItems}}" />

      <view wx:if="{{selectedDetail}}" class="detail-card">
        <text class="detail-date">{{selectedDetail.fullDate}}</text>
        <view class="detail-row">
          <text class="detail-label">{{copy.status}}</text>
          <text class="detail-value">{{selectedDetail.statusLabel}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">{{copy.remark}}</text>
          <text class="detail-value">{{selectedDetail.remark}}</text>
        </view>
      </view>

      <view class="summary-block">
        <text class="summary-title">{{copy.until}}</text>
        <text class="summary-value">{{summaryDays}} {{copy.day}}</text>
        <text class="summary-note">{{summaryNextStart}}</text>
        <view class="summary-action" bindtap="onSetupCycle">{{copy.adjust}}</view>
        <view class="summary-clear-action" bindtap="onClearCycleData">{{copy.clear}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{showCycleSetup}}" class="cycle-setup-mask" catchtap="onCloseCycleSetup">
    <view class="cycle-setup-sheet" catchtap="noop">
      <view class="cycle-setup-sheet__handle"></view>
      <text class="cycle-setup-sheet__title">{{copy.setupTitle}}</text>
      <text class="cycle-setup-sheet__desc">{{copy.setupDesc}}</text>
      <view class="cycle-privacy-confirm" bindtap="onToggleCyclePrivacy">
        <view class="cycle-privacy-confirm__box {{cyclePrivacyConfirmed ? 'cycle-privacy-confirm__box--checked' : ''}}">
          <text wx:if="{{cyclePrivacyConfirmed}}" class="cycle-privacy-confirm__mark">✓</text>
        </view>
        <view class="cycle-privacy-confirm__copy">
          <text class="cycle-privacy-confirm__title">{{copy.privacyTitle}}</text>
          <text class="cycle-privacy-confirm__desc">{{copy.privacyDesc}}</text>
        </view>
      </view>

      <view class="cycle-field">
        <text class="cycle-field__label">{{copy.lastStart}}</text>
        <picker mode="date" end="{{todayDateKey}}" value="{{cycleProfile.lastPeriodDate}}" bindchange="onCycleDateChange">
          <view class="cycle-field__picker">{{cycleProfile.lastPeriodDate}}</view>
        </picker>
      </view>

      <view class="cycle-field">
        <text class="cycle-field__label">{{copy.averageCycle}}</text>
        <input
          class="cycle-field__input"
          type="number"
          maxlength="2"
          value="{{cycleProfile.cycleLength}}"
          placeholder="{{copy.example28}}"
          placeholder-class="cycle-field__placeholder"
          bindinput="onCycleLengthInput"
        />
      </view>

      <view class="cycle-field">
        <text class="cycle-field__label">{{copy.periodLength}}</text>
        <input
          class="cycle-field__input"
          type="number"
          maxlength="2"
          value="{{cycleProfile.periodLength}}"
          placeholder="{{copy.example5}}"
          placeholder-class="cycle-field__placeholder"
          bindinput="onPeriodLengthInput"
        />
      </view>

      <view class="cycle-setup-sheet__actions">
        <view class="cycle-setup-sheet__button cycle-setup-sheet__button--ghost" bindtap="onCloseCycleSetup">{{commonCancel}}</view>
        <view class="cycle-setup-sheet__button cycle-setup-sheet__button--primary {{isSavingCycle ? 'cycle-setup-sheet__button--disabled' : ''}}" bindtap="onSaveCycleSetup">{{isSavingCycle ? commonSaving : copy.saveView}}</view>
      </view>
    </view>
  </view>
</view>
