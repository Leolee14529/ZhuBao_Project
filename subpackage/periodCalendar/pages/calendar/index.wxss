@import "../../styles/typography.wxss";

.calendar-page {
  min-height: 100vh;
  background-color: #02060d;
  background-image: radial-gradient(circle at 50% 18%, rgba(18, 28, 47, 0.24), transparent 32%), linear-gradient(180deg, #02070f 0%, #02060d 52%, #01050b 100%);
  color: #ffffff;
  overflow-x: hidden;
  box-sizing: border-box;
}
.page-content {
  width: 100%;
  max-width: 480px;
  margin: 0 auto;
  padding: 24rpx 24rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.calendar-surface {
  margin-top: 28rpx;
  padding: 0 10rpx 4rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.026) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.035);
  box-sizing: border-box;
  overflow: hidden;
}
.cycle-preview-card {
  margin-top: 26rpx;
  padding: 24rpx 26rpx 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.045);
  box-sizing: border-box;
  overflow: hidden;
}
.cycle-state-placeholder {
  min-height: 300rpx;
  margin-top: 26rpx;
  padding: 28rpx 26rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  background: rgba(255, 255, 255, 0.035);
  box-sizing: border-box;
}
.cycle-state-placeholder__line {
  width: 88%;
  height: 18rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
}
.cycle-state-placeholder__line:first-child { margin-top: 0; }
.cycle-state-placeholder__line-short { width: 28%; }
.cycle-state-placeholder__line-title { width: 72%; height: 30rpx; }
.cycle-state-placeholder__action {
  width: 100%;
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: rgba(8, 110, 78, 0.34);
}
.cycle-preview-card__eyebrow {
  display: block;
  color: #8ef0cf;
  font-size: 23rpx;
  font-weight: 500;
}
.cycle-preview-card__title {
  display: block;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.42;
}
.cycle-preview-card__desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 23rpx;
  line-height: 1.65;
}
.cycle-preview-card__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(8, 110, 78, 0.9);
  border: 1rpx solid rgba(46, 208, 151, 0.22);
  color: #8ef0cf;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  text-align: center;
}
.detail-card {
  margin-top: 32rpx;
  padding: 32rpx 26rpx 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}
.detail-date {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #ffffff;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}
.detail-label {
  flex: none;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.56);
}
.detail-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.45;
}
.detail-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 320rpx;
  height: 84rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: rgba(8, 110, 78, 0.9);
  border: 1rpx solid rgba(46, 208, 151, 0.22);
  color: #8ef0cf;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}
.summary-block {
  margin-top: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}
.summary-title { display: block; font-size: 24rpx; color: rgba(255, 255, 255, 0.82); }
.summary-value {
  display: block;
  margin-top: 14rpx;
  font-size: 50rpx;
  line-height: 1;
  font-weight: 500;
  color: #ff3d71;
}
.summary-note { display: block; margin-top: 14rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.78); }
.summary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin-top: 26rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 104, 138, 0.18);
  background: linear-gradient(90deg, rgba(120, 26, 54, 0.96) 0%, rgba(166, 36, 72, 0.98) 50%, rgba(120, 26, 54, 0.96) 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
  text-align: center;
  letter-spacing: 0;
  box-shadow: 0 10rpx 24rpx rgba(120, 26, 54, 0.26);
}
.summary-clear-action {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.56);
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}
