.insight-card {
  min-height: 144rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: #171922;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
}

.insight-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
}

.insight-value {
  display: block;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.insight-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(221, 227, 223, 0.48);
}
