.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.product-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #101413;
  aspect-ratio: 0.82;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(50, 218, 132, 0.92);
  color: #082114;
  font-size: 22rpx;
  font-weight: 500;
}
