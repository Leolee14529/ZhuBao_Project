<view class="fortune-card {{flipped ? 'is-flipped' : ''}}" bindtap="toggleCard">
  <view class="fortune-face fortune-front">
    <view class="fortune-grid"></view>
    <view class="fortune-head">
      <view class="fortune-label">
        <view class="fortune-dot"></view>
        <text>Today's Inspiration</text>
      </view>
      <text class="fortune-no">NO.88</text>
    </view>
    <view class="fortune-center">
      <view class="fortune-ring">
        <view class="fortune-ring-middle">
          <view class="fortune-ring-inner">
            <text class="fortune-symbol">Xun</text>
          </view>
        </view>
      </view>
      <text class="fortune-title">Fresh</text>
      <text class="fortune-subtitle">Wind / Wood</text>
    </view>
    <view class="fortune-quote-box">
      <text class="fortune-quote-mark">“</text>
      <text class="fortune-quote-text">Return your attention to one small thing nearby. Take six slow breaths. Today's color: emerald green.</text>
    </view>
  </view>
  <view class="fortune-face fortune-back">
    <view class="fortune-grid"></view>
    <text class="fortune-back-title">DAILY INSPIRATION</text>
    <text class="fortune-back-copy">Tap the card to flip</text>
  </view>
</view>
