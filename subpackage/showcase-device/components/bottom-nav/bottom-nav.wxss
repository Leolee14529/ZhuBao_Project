.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 18rpx 12rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(20, 20, 22, 0.84);
  backdrop-filter: blur(18rpx);
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.04),
    0 20rpx 48rpx rgba(0, 0, 0, 0.22);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: rgba(236, 240, 237, 0.34);
}

.tab-icon {
  font-size: 28rpx;
  line-height: 1;
}

.tab-label {
  font-size: 22rpx;
}

.is-active {
  color: #37df89;
}
