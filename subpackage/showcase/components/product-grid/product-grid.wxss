.product-grid {
  overflow: hidden;
}

.product-card {
  float: left;
  width: 339rpx;
  height: 414rpx;
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #101413;
}

.product-card:nth-child(2n) {
  float: right;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(50, 218, 132, 0.92);
  color: #082114;
  font-size: 22rpx;
  font-weight: 700;
}
