.fortune-card {
  position: relative;
  min-height: 760rpx;
  border-radius: 34rpx;
  overflow: hidden;
  perspective: 1200rpx;
  transform-style: preserve-3d;
}

.fortune-face {
  position: absolute;
  inset: 0;
  padding: 30rpx;
  border-radius: 34rpx;
  border: 1px solid rgba(55, 206, 137, 0.18);
  background:
    linear-gradient(180deg, rgba(10, 22, 18, 0.96), rgba(9, 18, 15, 0.92)),
    radial-gradient(circle at center, rgba(32, 112, 78, 0.16), transparent 58%);
  box-shadow:
    inset 0 0 0 1px rgba(37, 143, 99, 0.08),
    0 24rpx 80rpx rgba(0, 0, 0, 0.28);
  backface-visibility: hidden;
  transition: transform 420ms ease;
}

.fortune-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(74, 122, 101, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(74, 122, 101, 0.08) 1px, transparent 1px);
  background-size: 46rpx 46rpx;
  opacity: 0.5;
}

.fortune-front {
  transform: rotateY(0deg);
}

.fortune-back {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotateY(180deg);
}

.is-flipped .fortune-front {
  transform: rotateY(-180deg);
}

.is-flipped .fortune-back {
  transform: rotateY(0deg);
}

.fortune-head,
.fortune-center,
.fortune-quote-box,
.fortune-back-title,
.fortune-back-copy {
  position: relative;
  z-index: 1;
}

.fortune-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fortune-label {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: #34dd88;
  font-size: 26rpx;
  font-weight: 500;
}

.fortune-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34dd88;
  box-shadow: 0 0 18rpx rgba(52, 221, 136, 0.7);
}

.fortune-no {
  color: rgba(219, 226, 222, 0.48);
  font-size: 24rpx;
  font-weight: 500;
}

.fortune-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 86rpx;
}

.fortune-ring {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(39, 196, 117, 0.24);
}

.fortune-ring-middle {
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(39, 196, 117, 0.9);
  box-shadow: 0 0 30rpx rgba(39, 196, 117, 0.24);
}

.fortune-ring-inner {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(188, 255, 221, 0.18);
}

.fortune-symbol {
  font-size: 62rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.fortune-title {
  margin-top: 64rpx;
  font-size: 74rpx;
  line-height: 1;
  font-weight: 500;
}

.fortune-subtitle {
  margin-top: 18rpx;
  font-size: 36rpx;
  color: rgba(234, 239, 236, 0.52);
}

.fortune-quote-box {
  margin-top: 78rpx;
  padding: 28rpx 28rpx 28rpx 38rpx;
  border-radius: 26rpx;
  background: rgba(0, 0, 0, 0.26);
}

.fortune-quote-mark {
  position: absolute;
  left: 22rpx;
  top: 12rpx;
  color: #30dc86;
  font-size: 44rpx;
  font-weight: 500;
}

.fortune-quote-text {
  display: block;
  padding-left: 20rpx;
  font-size: 32rpx;
  line-height: 1.65;
  color: rgba(242, 246, 243, 0.88);
}

.fortune-back-title {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.fortune-back-copy {
  margin-top: 20rpx;
  color: rgba(233, 239, 235, 0.58);
  font-size: 28rpx;
}
