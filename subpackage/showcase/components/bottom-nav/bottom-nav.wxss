.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  padding: 18rpx 12rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(20, 20, 22, 0.84);
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.04),
    0 20rpx 48rpx rgba(0, 0, 0, 0.22);
  overflow: hidden;
}

.tab-item {
  float: left;
  width: 33.33%;
  text-align: center;
  color: rgba(236, 240, 237, 0.34);
}

.tab-icon {
  display: block;
  font-size: 28rpx;
  line-height: 1;
}

.tab-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.is-active {
  color: #37df89;
}
