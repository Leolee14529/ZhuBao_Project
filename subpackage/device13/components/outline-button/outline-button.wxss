.outline-button {
  display: block;
  width: 100%;
  height: 110rpx;
  margin-top: 54rpx;
  border-radius: 55rpx;
  padding: 0;
  line-height: 110rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  color: rgba(255, 255, 255, 0.92);
  font-size: 19px;
  font-weight: 500;
}

.outline-button::after {
  border: 0;
}
