.pairing-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 24%, rgba(23, 111, 255, 0.22), transparent 26%),
    linear-gradient(180deg, #02070f 0%, #02060d 48%, #01050b 100%);
  color: #ffffff;
}

.page-content {
  padding: 0 36rpx 42rpx;
}

.page-title {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.device-empty-state {
  display: block;
  margin-top: 40rpx;
}

.connection-card {
  display: block;
  margin-top: 36rpx;
}
