<view class="pairing-page" style="padding-top: {{statusBarHeight}}px;">
  <device-topbar />

  <view class="page-content">
    <text class="page-title">Device Connection</text>

    <empty-state
      wx:if="{{deviceStatus === 'failed'}}"
      class="device-empty-state"
      title="Device connection failed"
      desc="Check Bluetooth, then move the ring close to your phone again"
      buttonText="Reconnect"
      type="device"
      bind:action="onRetryConnect"
    ></empty-state>

    <block wx:else>
    <connecting-hero
      image-src="/subpackage/device13/assets/ring-connecting.png"
      ring-name="No device"
      status-text="Connecting..."
      helper-text="Keep the device close to your phone"
    />

    <device-section-card
      title="Device Info"
      rows="{{infoRows}}"
      bind:select="onInfoSelect"
    />

    <device-section-card
      class="connection-card"
      title="Connection"
      rows="{{connectionRows}}"
      bind:select="onConnectionSelect"
    />

    <outline-button text="Cancel Connection" bind:action="onCancelConnect" />
    </block>
  </view>
</view>
