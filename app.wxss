page {
  width: 100%;
  height: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #000000;
  background-color: #000000;
  color: #ffffff;
}

view,
text,
button,
input,
textarea,
picker,
label,
navigator,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", Arial, sans-serif !important;
}

image { box-sizing: border-box; }
button { padding: 0; margin: 0; border: 0; background: transparent; line-height: inherit; font: inherit; }
button::after { border: 0; }
.screen-shell {
  min-height: 100vh;
  background: #000000;
  background-color: #000000;
  color: #ffffff;
  overflow: hidden;
}
.page-scroll { height: 100vh; }
.glass-card {
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 26rpx 70rpx rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(24rpx);
}
.safe-bottom-space { height: 150rpx; }

@keyframes page-enter {
  from { opacity: 0; }
  to { opacity: 1; }
}

.login-page,
.home-page,
.data-page,
.settings-page,
.legal-page,
.sleep-page,
.customize-page,
.calendar-page,
.products-page,
.product-detail-page {
  animation: page-enter 200ms ease-out both;
}
